<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover">
  <title>🌊 Mythic Waters · Fixed Fishing RPG</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      background: #0a0a1a; display:flex; justify-content:center; align-items:center; min-height:100vh;
      font-family:'Segoe UI',system-ui,sans-serif; padding:8px;
      background-image:radial-gradient(ellipse at center, #1a1a3a 0%, #0a0a1a 100%);
      cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24'><circle cx='12' cy='12' r='8' fill='white' stroke='black' stroke-width='2'/><line x1='12' y1='2' x2='12' y2='8' stroke='black' stroke-width='2'/><line x1='12' y1='16' x2='12' y2='22' stroke='black' stroke-width='2'/><line x1='2' y1='12' x2='8' y2='12' stroke='black' stroke-width='2'/><line x1='16' y1='12' x2='22' y2='12' stroke='black' stroke-width='2'/></svg>") 12 12, crosshair;
    }
    .game-container { display:flex; flex-direction:column; align-items:center; gap:4px; max-width:950px; width:100%; }
    .game-wrapper { background:linear-gradient(145deg, #1e2e4f 0%, #0c1a2c 100%); border-radius:24px; padding:8px; box-shadow:0 20px 40px rgba(0,0,0,0.8); }
    canvas { display:block; margin:0 auto; border-radius:18px; box-shadow:0 0 30px rgba(61,110,140,0.5); background:#1a2e3c; width:100%; height:auto; max-width:900px; aspect-ratio:16/10; }
    .hud-top { display:flex; justify-content:space-between; padding:6px 12px; background:rgba(0,0,0,0.85); border-radius:18px; color:white; font-size:0.7rem; margin-bottom:4px; backdrop-filter:blur(10px); flex-wrap:wrap; gap:3px; }
    .ui-bar { display:flex; justify-content:space-between; align-items:center; padding:6px 12px; background:rgba(10,20,35,0.9); border-radius:22px; margin-top:6px; color:#e6f7ff; flex-wrap:wrap; gap:6px; font-size:0.65rem; }
    button { background:linear-gradient(180deg, #3d6e8c 0%, #1b4057 100%); border:none; color:white; padding:6px 12px; border-radius:18px; font-weight:bold; cursor:pointer; box-shadow:0 3px 0 #0f1e2e; font-size:0.6rem; border-bottom:2px solid #7fc9ff; transition:all 0.1s; }
    button:hover { transform:translateY(-2px); }
    button:active { transform:translateY(2px); }
    .modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:linear-gradient(160deg, #0d1a2e, #162a3b); border:3px solid #5b9bb5; border-radius:18px; padding:16px; color:white; z-index:200; min-width:320px; max-width:600px; max-height:80vh; overflow-y:auto; display:none; box-shadow:0 20px 40px black; }
    .modal.active { display:block; animation:fadeIn 0.3s; }
    @keyframes fadeIn { from{opacity:0; transform:translate(-50%,-48%);} to{opacity:1; transform:translate(-50%,-50%);} }
    
    .qte-bar-container { position:fixed; bottom:80px; left:50%; transform:translateX(-50%); display:none; width:500px; height:45px; background:rgba(0,0,0,0.9); border-radius:22px; z-index:150; border:3px solid #555; overflow:hidden; }
    .qte-bar-container.active { display:block; }
    .qte-bar-fill { height:100%; background:#4caf92; transition:width 0.05s; }
    .qte-marker { position:absolute; top:-4px; width:8px; height:53px; background:white; box-shadow:0 0 20px white; border-radius:4px; z-index:2; transition:left 0.05s; }
    .qte-sweet-spot { position:absolute; top:0; height:100%; background:rgba(255,68,68,0.5); border-left:3px solid #ff4444; border-right:3px solid #ff4444; z-index:1; }
    
    .qte-click-area { position:fixed; top:0; left:0; width:100%; height:100%; display:none; z-index:149; background:rgba(0,0,0,0.3); }
    .qte-click-area.active { display:block; }
    .qte-click-target { position:absolute; width:80px; height:80px; background:rgba(255,68,68,0.7); border-radius:50%; cursor:pointer; animation:qtePulse 0.8s infinite; }
    @keyframes qtePulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.3);} }
    
    .catch-card { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(0); border-radius:18px; padding:18px; color:white; z-index:300; text-align:center; min-width:250px; transition:transform 0.2s cubic-bezier(0.68,-0.55,0.27,1.55); }
    .catch-card.show { transform:translate(-50%,-50%) scale(1); }
    
    .admin-panel { position:fixed; bottom:10px; right:10px; background:rgba(0,0,0,0.9); padding:8px; border-radius:12px; z-index:400; font-size:0.55rem; color:white; display:none; }
    .admin-panel.active { display:block; }
  </style>
</head>
<body>
<div class="game-container">
  <div class="hud-top">
    <span id="weatherHud">☀️ Clear</span>
    <span id="timeHud">🕐 12:00</span>
    <span id="eventHud">🎣 Normal</span>
    <span id="pearlHud">💎<span id="pearlCount">0</span>/6</span>
    <span id="eldritchHud">👁️0/5</span>
    <span id="bossChance">⚡10%</span>
  </div>
  <div class="game-wrapper">
    <canvas id="gameCanvas" width="900" height="560"></canvas>
    <div class="ui-bar">
      <span>🎣<span id="playerName">Angler</span></span>
      <span>🐟<span id="fishCount">0</span></span>
      <span>💰<span id="goldDisplay">150</span></span>
      <span>🚤<span id="boatStatus">No</span></span>
      <button onclick="game.openInfoDex()">📖 Dex</button>
      <button onclick="game.openInventory()">🎒 Inv</button>
      <button onclick="game.openShop()">🏪 Shop</button>
      <button onclick="game.saveGame()">💾 Save</button>
      <button onclick="document.getElementById('adminPanel').classList.toggle('active')">🔧</button>
    </div>
  </div>
</div>

<div id="infoDexModal" class="modal">
  <span onclick="this.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>📖 InfoDex · <span id="bioCount">0</span>/22</h3>
  <div style="display:flex;gap:6px;margin:6px 0;">
    <button onclick="game.showFishTab()" id="fishTabBtn" style="background:#4caf92;">🐟Fish</button>
    <button onclick="game.showMutationTab()" id="mutTabBtn">🧬Mut</button>
    <button onclick="game.showDropTab()" id="dropTabBtn">📊Rates</button>
  </div>
  <div id="infoDexContent" style="max-height:380px;overflow-y:auto;"></div>
</div>

<div id="inventoryModal" class="modal">
  <span onclick="this.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🎒 Inventory</h3>
  <p>💰<span id="invGold">150</span> | 💎<span id="invPearls">0</span>/6 | Perfect: <span id="invPearlStatus">❌</span></p>
  <div id="inventoryList" style="max-height:300px;overflow-y:auto;"></div>
</div>

<div id="shopModal" class="modal">
  <span onclick="this.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🏪 Fishin Jimmy</h3>
  <button onclick="game.sellFish()" style="display:block;width:100%;margin:4px 0;">💰 Sell All</button>
  <button onclick="game.buyBoat()" style="display:block;width:100%;margin:4px 0;">🚤 Boat (1000💰)</button>
  <button onclick="game.craftPearl()" id="craftPearlBtn" style="display:none;width:100%;margin:4px 0;">💎 Craft Pearl</button>
  <p style="font-size:0.6rem;">Fish:<span id="shopFishCount">0</span> | Pearls:<span id="shopPearls">0</span>/6</p>
</div>

<div class="qte-bar-container" id="qteBarContainer">
  <div class="qte-sweet-spot" id="qteSweetSpot"></div>
  <div class="qte-marker" id="qteMarker"></div>
  <div class="qte-bar-fill" id="qteBarFill"></div>
</div>
<div class="qte-click-area" id="qteClickArea"></div>
<div class="catch-card" id="catchCard">
  <div id="catchEmoji" style="font-size:2.5rem;">🐟</div>
  <h2 id="catchName">Fish</h2>
  <div id="catchRarity">Common</div>
  <div id="catchWeight">0.0 lbs</div>
  <div id="catchMutation"></div>
  <div id="catchValue">💰0</div>
</div>
<div class="admin-panel" id="adminPanel">
  <b>Admin</b><br>
  <button onclick="game.spawnBoss()">⚡Spawn Boss</button>
  <button onclick="game.givePearls()">💎+6 Pearls</button>
  <button onclick="game.giveGold()">💰+5000</button>
  <button onclick="game.forceEldritch()">👁️Force Eldritch</button>
  <button onclick="game.setWeather('storm')">⛈️Storm</button>
  <button onclick="game.setWeather('fog')">🌫️Fog</button>
  <button onclick="game.setWeather('aurora')">🌌Aurora</button>
</div>

<script>
class Game {
  constructor() {
    this.canvas = document.getElementById('gameCanvas');
    this.ctx = this.canvas.getContext('2d');
    this.player = {
      x:400, y:350, speed:2.8, name:'Angler'+Math.floor(Math.random()*1000),
      gold:150, fishCaught:0, inventory:[], discovered:new Set(),
      mutationRecords:{}, bestWeights:{},
      boatOwned:false, inOcean:false,
      isCasting:false, castTimer:0, castTarget:null,
      fishOnLine:null, waitingForBite:false, biteTimer:0,
      pearlShards:0, perfectPearl:false,
      eldritchCaught:0, lovecrafted:false, bossFight:null,
    };
    this.dayTime=0.5; this.weather='clear'; this.weatherTimer=0;
    this.particles=[]; this.floatingTexts=[]; this.screenShake=0; this.glitchActive=false;
    this.qteActive=false; this.qteType='bar'; this.qteMarkerPos=50; this.qteMarkerSpeed=1.5; this.qteMarkerDir=1;
    this.qteProgress=50; this.qteSweetStart=38; this.qteSweetEnd=48; this.qteFish=null;
    this.clickTargets=[];
    this.bossEvent=null; this.bossTimer=0;
    this.forceNextFish=null;
    this.loadGame();
    this.setupUI();
    this.updateUI();
    this.gameLoop();
    setInterval(()=>this.saveGame(),30000);
  }

  setupUI() {
    this.canvas.addEventListener('click',e=>{
      const r=this.canvas.getBoundingClientRect();
      const mx=(e.clientX-r.left)*(900/r.width);
      const my=(e.clientY-r.top)*(560/r.height);
      if(Math.hypot(mx-500,my-460)<30){this.openShop();return;}
      if(this.qteType==='click'&&this.clickTargets.length>0){
        for(let t of this.clickTargets){
          const cx=t.x*r.width/900+r.left;
          const cy=t.y*r.height/560+r.top;
          if(Math.hypot(e.clientX-cx,e.clientY-cy)<40){
            this.clickTargets=this.clickTargets.filter(x=>x!==t);
            this.qteProgress+=15;
            document.getElementById('qteBarFill').style.width=this.qteProgress+'%';
            if(this.qteProgress>=100){this.qteActive=false;document.getElementById('qteClickArea').classList.remove('active');document.getElementById('qteBarContainer').classList.remove('active');this.catchFish(this.qteFish);}
            return;
          }
        }
      }
      if(!this.qteActive&&!this.player.waitingForBite&&!this.player.fishOnLine)this.castLine(mx,my);
    });

    window.addEventListener('keydown',e=>{
      this.keys=this.keys||{};
      this.keys[e.code]=true;
      if(e.code==='Space'){
        e.preventDefault();
        if(this.qteActive&&this.qteType==='bar')this.hookFish();
        else if(this.player.boatOwned&&!this.player.waitingForBite&&!this.player.isCasting&&!this.qteActive){
          this.player.inOcean=!this.player.inOcean;
          this.addFloatingText(this.player.inOcean?'🌊Ocean':'🏝️Land',this.player.x,this.player.y-20,40,'#7fc9ff');
        }
      }
      if(e.code==='Backquote'){e.preventDefault();document.getElementById('adminPanel').classList.toggle('active');}
    });
    window.addEventListener('keyup',e=>{if(this.keys)this.keys[e.code]=false;});

    setInterval(()=>{
      if(this.qteActive)return;
      let dx=0,dy=0;
      if(this.keys&&(this.keys['KeyW']||this.keys['ArrowUp']))dy--;
      if(this.keys&&(this.keys['KeyS']||this.keys['ArrowDown']))dy++;
      if(this.keys&&(this.keys['KeyA']||this.keys['ArrowLeft']))dx--;
      if(this.keys&&(this.keys['KeyD']||this.keys['ArrowRight']))dx++;
      if(dx||dy){const l=Math.sqrt(dx*dx+dy*dy);this.player.x=Math.min(880,Math.max(20,this.player.x+dx/l*this.player.speed));this.player.y=Math.min(540,Math.max(20,this.player.y+dy/l*this.player.speed));}
    },16);
  }

  saveGame() {
    const data = {
      name:this.player.name, gold:this.player.gold, fishCaught:this.player.fishCaught,
      discovered:Array.from(this.player.discovered), mutationRecords:this.player.mutationRecords,
      bestWeights:this.player.bestWeights, boatOwned:this.player.boatOwned,
      pearlShards:this.player.pearlShards, perfectPearl:this.player.perfectPearl,
      eldritchCaught:this.player.eldritchCaught, lovecrafted:this.player.lovecrafted,
    };
    localStorage.setItem('mythicWatersSave',JSON.stringify(data));
    this.addFloatingText('💾Saved!',this.player.x,this.player.y-25,40,'#4caf92');
  }

  loadGame() {
    const data = JSON.parse(localStorage.getItem('mythicWatersSave'));
    if(data){
      this.player.name=data.name||this.player.name;
      this.player.gold=data.gold||150;
      this.player.fishCaught=data.fishCaught||0;
      this.player.discovered=new Set(data.discovered||[]);
      this.player.mutationRecords=data.mutationRecords||{};
      this.player.bestWeights=data.bestWeights||{};
      this.player.boatOwned=data.boatOwned||false;
      this.player.pearlShards=data.pearlShards||0;
      this.player.perfectPearl=data.perfectPearl||false;
      this.player.eldritchCaught=data.eldritchCaught||0;
      this.player.lovecrafted=data.lovecrafted||false;
    }
  }

  // Admin functions
  spawnBoss(){const b=this.fishDB.filter(f=>f.boss)[0];if(b){this.bossEvent=b;this.weather='storm';this.bossTimer=900;this.addFloatingText('⚡Boss!',450,280,100,'#ff0000');}}
  givePearls(){this.player.pearlShards=6;this.updateUI();this.addFloatingText('💎+6',this.player.x,this.player.y-20,50,'#ffd700');}
  giveGold(){this.player.gold+=5000;this.updateUI();this.addFloatingText('💰+5000',this.player.x,this.player.y-20,50,'#ffd700');}
  forceEldritch(){this.forceNextFish='Eldritch';this.addFloatingText('👁️Next:Eldritch',this.player.x,this.player.y-20,50,'#2d5a27');}
  setWeather(w){this.weather=w;this.weatherTimer=999;this.updateUI();this.addFloatingText('🌤️'+w,this.player.x,this.player.y-20,40,'#fff');}

  get fishDB() {
    return [
      {id:'bluegill',name:'Bluegill',rarity:'Common',weight:1.5,value:10,emoji:'🐟',color:'#a0b8c0'},
      {id:'bass',name:'Bass',rarity:'Uncommon',weight:3.2,value:28,emoji:'🐠',color:'#7c9c4a'},
      {id:'catfish',name:'Catfish',rarity:'Common',weight:4.1,value:15,emoji:'🐡',color:'#8b7355'},
      {id:'sunfish',name:'Sunfish',rarity:'Uncommon',weight:8.2,value:35,emoji:'🌞',color:'#ffd700'},
      {id:'trout',name:'Trout',rarity:'Rare',weight:5.8,value:65,emoji:'🐟',color:'#e86f8a'},
      {id:'salmon',name:'Salmon',rarity:'Rare',weight:12.3,value:80,emoji:'🐠',color:'#ff6347'},
      {id:'carp',name:'Golden Carp',rarity:'Rare',weight:9.4,value:70,emoji:'✨',color:'#ffd700'},
      {id:'marlin',name:'Marlin',rarity:'Epic',weight:35,value:200,emoji:'🐋',color:'#4169e1'},
      {id:'glimmerfin',name:'Glimmerfin',rarity:'Epic',weight:18.5,value:150,emoji:'🦑',color:'#c9a0ff',weather:'aurora'},
      {id:'angler',name:'Anglerfish',rarity:'Epic',weight:22,value:180,emoji:'👾',color:'#2f4f4f',time:'night'},
      {id:'stormwhale',name:'Storm Whale',rarity:'Legendary',weight:55,value:500,emoji:'🐳',color:'#4a6fa5',weather:'storm'},
      {id:'moonserpent',name:'Moon Serpent',rarity:'Mythical',weight:85,value:900,emoji:'🐉',color:'#f0e68c',time:'night'},
      {id:'tidewraith',name:'Tide Wraith',rarity:'Tale Fish',weight:130,value:2000,emoji:'👻',color:'#40e0d0',weather:'fog',time:'night'},
      {id:'cthulhu',name:'Cthulhu',rarity:'Eldritch',weight:200,value:5000,emoji:'🐙',color:'#2d5a27',eldritch:true},
      {id:'dagon',name:'Dagon',rarity:'Eldritch',weight:250,value:5500,emoji:'🦈',color:'#1a3a4a',eldritch:true},
      {id:'voidkraken',name:'Void Kraken',rarity:'Eldritch',weight:190,value:5200,emoji:'🦑',color:'#0a0a2a',eldritch:true},
      {id:'leviathan',name:'Leviathan',rarity:'World Boss',weight:500,value:10000,emoji:'🐉',color:'#ff0000',boss:true},
      {id:'poseidonguard',name:"Poseidon's Guard",rarity:'Mythical Tale',weight:350,value:15000,emoji:'🔱',color:'#4a90d9',requiresPearl:true},
    ];
  }

  get mutations() {
    return [
      {name:'Alpha',color:'#ff6600',wMult:1.8,vMult:1.5,chance:0.08},
      {name:'Melanistic',color:'#1a1a1a',wMult:1.0,vMult:2.2,chance:0.05},
      {name:'Piebald',color:'#fff',wMult:1.0,vMult:2.8,chance:0.03},
      {name:'Albino',color:'#ffcccc',wMult:0.9,vMult:3.5,chance:0.005},
      {name:'Giant',color:'#ff8c00',wMult:2.5,vMult:3.0,chance:0.04},
      {name:'Fluorescent',color:'#ff00ff',wMult:1.0,vMult:2.5,chance:0.06},
      {name:'Radioactive',color:'#00ff00',wMult:0.8,vMult:1.5,chance:0.07},
    ];
  }

  get rarityChances() {
    return {Common:45,Uncommon:25,Rare:15,Epic:8,Legendary:3.5,Mythical:1.8,'Tale Fish':0.5,Eldritch:0.15,'World Boss':5,'Mythical Tale':0.02};
  }

  updateUI() {
    document.getElementById('playerName').textContent=this.player.name.substring(0,10);
    document.getElementById('fishCount').textContent=this.player.fishCaught;
    document.getElementById('goldDisplay').textContent=this.player.gold;
    document.getElementById('boatStatus').textContent=this.player.boatOwned?'⛵Yes':'❌No';
    document.getElementById('pearlCount').textContent=this.player.pearlShards;
    document.getElementById('eldritchHud').textContent=`👁️${this.player.eldritchCaught}/5`;
    const wEmoji={clear:'☀️',rain:'🌧️',fog:'🌫️',storm:'⛈️',aurora:'🌌'};
    document.getElementById('weatherHud').textContent=`${wEmoji[this.weather]}${this.weather}`;
    document.getElementById('timeHud').textContent=`🕐${Math.floor(this.dayTime*24)}:00`;
    document.getElementById('eventHud').textContent=this.bossEvent?'⚡BOSS!':'🎣Normal';
    document.getElementById('bossChance').textContent=`⚡${this.player.inOcean?10:0}%`;
    const cb=document.getElementById('craftPearlBtn');
    if(cb)cb.style.display=(this.player.pearlShards>=6&&!this.player.perfectPearl)?'block':'none';
  }

  openInfoDex() {
    document.getElementById('bioCount').textContent=this.player.discovered.size;
    document.getElementById('infoDexModal').classList.add('active');
    this.showFishTab();
  }

  showFishTab() {
    const c=document.getElementById('infoDexContent');
    if(!c)return;
    c.innerHTML='<div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;">';
    this.fishDB.forEach(f=>{
      const d=this.player.discovered.has(f.id);
      const ch=this.rarityChances[f.rarity]||0;
      c.innerHTML+=`<div style="background:#162f3b;padding:5px;border-radius:8px;font-size:0.55rem;border-left:3px solid ${d?f.color:'#555'};opacity:${d?1:0.5};">
        <strong>${d?f.emoji+' '+f.name:'???'}</strong><br>${f.rarity}·${ch}%·${f.weight}lbs
        ${d&&this.player.mutationRecords[f.id]?`<br><small style="color:#ffd966;">🧬${this.player.mutationRecords[f.id].join(',')}</small>`:''}
      </div>`;
    });
    c.innerHTML+='</div>';
    document.getElementById('fishTabBtn').style.background='#4caf92';
    document.getElementById('mutTabBtn').style.background='';
    document.getElementById('dropTabBtn').style.background='';
  }

  showMutationTab() {
    const c=document.getElementById('infoDexContent');
    if(!c)return;
    c.innerHTML='<h4 style="color:#ffd966;">🧬Mutations</h4>';
    this.mutations.forEach(m=>{c.innerHTML+=`<div style="background:#0d1a2e;padding:5px;border-radius:6px;margin:2px 0;font-size:0.55rem;border-left:3px solid ${m.color};"><span style="color:${m.color};">●</span><b>${m.name}</b>: ${(m.chance*100).toFixed(1)}%·${m.vMult}x value</div>`;});
    document.getElementById('fishTabBtn').style.background='';
    document.getElementById('mutTabBtn').style.background='#4caf92';
    document.getElementById('dropTabBtn').style.background='';
  }

  showDropTab() {
    const c=document.getElementById('infoDexContent');
    if(!c)return;
    c.innerHTML='<h4 style="color:#ffd966;">📊Drop Rates</h4>';
    c.innerHTML+='<table style="width:100%;font-size:0.55rem;border-collapse:collapse;">';
    c.innerHTML+='<tr style="background:#1a3a4a;"><th>Rarity</th><th>Base</th><th>Ocean</th></tr>';
    Object.entries(this.rarityChances).forEach(([r,ch])=>{c.innerHTML+=`<tr><td>${r}</td><td>${ch}%</td><td>${(ch*2).toFixed(1)}%</td></tr>`;});
    c.innerHTML+='</table>';
    c.innerHTML+='<p style="font-size:0.5rem;">💎Pearl:1%·⚡Boss:10% ocean</p>';
    document.getElementById('fishTabBtn').style.background='';
    document.getElementById('mutTabBtn').style.background='';
    document.getElementById('dropTabBtn').style.background='#4caf92';
  }

  openInventory() {
    document.getElementById('invGold').textContent=this.player.gold;
    document.getElementById('invPearls').textContent=this.player.pearlShards;
    document.getElementById('invPearlStatus').textContent=this.player.perfectPearl?'✅':'❌';
    const l=document.getElementById('inventoryList');
    if(this.player.inventory.length===0){l.innerHTML='<p style="color:#888;">Empty</p>';}
    else{l.innerHTML=this.player.inventory.map(i=>{
      const v=Math.floor(i.fish.value*(i.mutation?.vMult||1));
      return`<div style="background:#162f3b;padding:4px 6px;border-radius:6px;margin:2px 0;font-size:0.55rem;display:flex;justify-content:space-between;">
        <span>${i.fish.emoji}${i.fish.name} <span style="color:${i.fish.color};">${i.fish.rarity}</span></span>
        <span>${i.weight}lbs ${i.mutation?'🧬'+i.mutation.name:''}💰${v}</span></div>`;}).join('');}
    document.getElementById('inventoryModal').classList.add('active');
  }

  openShop() {
    document.getElementById('shopFishCount').textContent=this.player.inventory.length;
    document.getElementById('shopPearls').textContent=this.player.pearlShards;
    document.getElementById('shopModal').classList.add('active');
    this.updateUI();
  }

  sellFish() {
    if(!this.player.inventory.length){this.addFloatingText('No fish!',this.player.x,this.player.y-20,40,'#ff4444');return;}
    const t=this.player.inventory.reduce((s,i)=>s+Math.floor(i.fish.value*(i.mutation?.vMult||1)),0);
    this.player.gold+=t;this.player.inventory=[];
    this.addFloatingText('💰+'+t,this.player.x,this.player.y-20,50,'#ffd700');
    this.updateUI();
  }

  buyBoat() {
    if(this.player.boatOwned){this.addFloatingText('Owned!',this.player.x,this.player.y-20,40,'#ffaa00');return;}
    if(this.player.gold<1000){this.addFloatingText('Need1000💰',this.player.x,this.player.y-20,40,'#ff4444');return;}
    this.player.boatOwned=true;this.player.gold-=1000;
    this.addFloatingText('🚤Boat!',this.player.x,this.player.y-20,50,'#ffd700');
    this.updateUI();
  }

  craftPearl() {
    if(this.player.pearlShards>=6&&!this.player.perfectPearl){
      this.player.perfectPearl=true;this.player.pearlShards=0;
      this.addFloatingText('💎Pearl!',this.player.x,this.player.y-20,60,'#ffd700');
      this.updateUI();
    }
  }

  castLine(tx,ty) {
    if(this.player.waitingForBite||this.player.fishOnLine||this.qteActive)return;
    this.player.isCasting=true;this.player.castTarget={x:tx,y:ty};this.player.castTimer=0;
    this.addFloatingText('🎣',this.player.x,this.player.y-15,25,'#fff');
  }

  selectFish() {
    if(this.forceNextFish){
      const f=this.fishDB.find(x=>x.rarity===this.forceNextFish);
      if(f){this.forceNextFish=null;return f;}
      this.forceNextFish=null;
    }
    let avail=this.fishDB.filter(f=>{
      if(f.boss&&!this.bossEvent)return false;
      if(f.requiresPearl&&!this.player.perfectPearl)return false;
      if(f.weather&&this.weather!==f.weather)return false;
      if(f.time==='night'&&this.dayTime>0.25&&this.dayTime<0.75)return false;
      if(f.eldritch&&!this.player.inOcean)return false;
      return true;
    });
    if(!avail.length)avail=this.fishDB.filter(f=>!f.boss&&!f.requiresPearl&&!f.eldritch);
    const bonus=this.player.inOcean?2.0:1.0;
    let t=0;
    const w=avail.map(f=>{const wt=(this.rarityChances[f.rarity]||1)*bonus;t+=wt;return{f,wt};});
    let r=Math.random()*t;
    for(let i of w){r-=i.wt;if(r<=0)return i.f;}
    return avail[0];
  }

  fishBites() {
    this.player.waitingForBite=false;
    const f=this.player.fishOnLine;
    if(!f)return;
    this.addFloatingText('❗',this.player.castTarget?.x||this.player.x,(this.player.castTarget?.y||this.player.y)-25,35,'#ff4444');
    this.screenShake=6;
    if(f.eldritch)this.glitchActive=true;
    
    // Random QTE type for variety
    const qteTypes=['bar','bar','click'];
    const chosenQTE=qteTypes[Math.floor(Math.random()*qteTypes.length)];
    
    if(chosenQTE==='click'){
      this.startClickQTE(f);
    }else{
      this.startBarQTE(f);
    }
  }

  startBarQTE(fish) {
    this.qteActive=true;this.qteType='bar';this.qteFish=fish;this.qteProgress=50;
    this.qteMarkerPos=20+Math.random()*60;this.qteMarkerDir=Math.random()>0.5?1:-1;
    const diff=['Legendary','Mythical','Tale Fish','Eldritch','World Boss','Mythical Tale'].includes(fish.rarity)?2.5:['Rare','Epic'].includes(fish.rarity)?1.5:0.7;
    this.qteMarkerSpeed=diff;
    const zoneW=['Legendary','Mythical','Tale Fish','Eldritch','World Boss','Mythical Tale'].includes(fish.rarity)?10:['Rare','Epic'].includes(fish.rarity)?15:25;
    this.qteSweetStart=50-zoneW/2;this.qteSweetEnd=50+zoneW/2;
    document.getElementById('qteSweetSpot').style.left=this.qteSweetStart+'%';
    document.getElementById('qteSweetSpot').style.width=(this.qteSweetEnd-this.qteSweetStart)+'%';
    document.getElementById('qteBarContainer').classList.add('active');
    document.getElementById('qteBarFill').style.background='#4caf92';
    document.getElementById('qteClickArea').classList.remove('active');
    this.updateQTEDisplay();
  }

  startClickQTE(fish) {
    this.qteActive=true;this.qteType='click';this.qteFish=fish;this.qteProgress=50;
    document.getElementById('qteBarContainer').classList.add('active');
    document.getElementById('qteBarFill').style.background='#ff8800';
    document.getElementById('qteClickArea').classList.add('active');
    document.getElementById('qteSweetSpot').style.left='0%';
    document.getElementById('qteSweetSpot').style.width='0%';
    this.clickTargets=[];
    this.spawnClickTarget();
  }

  spawnClickTarget() {
    if(!this.qteActive||this.qteType!=='click')return;
    const t={
      x:100+Math.random()*(900-200),
      y:100+Math.random()*(560-200),
      life:60
    };
    this.clickTargets.push(t);
    const area=document.getElementById('qteClickArea');
    const btn=document.createElement('div');
    btn.className='qte-click-target';
    btn.style.left=(t.x/900*100)+'%';
    btn.style.top=(t.y/560*100)+'%';
    btn.onclick=()=>{
      this.clickTargets=this.clickTargets.filter(x=>x!==t);
      btn.remove();
      this.qteProgress+=15;
      document.getElementById('qteBarFill').style.width=this.qteProgress+'%';
      if(this.qteProgress>=100){this.qteActive=false;document.getElementById('qteClickArea').classList.remove('active');document.getElementById('qteBarContainer').classList.remove('active');this.catchFish(this.qteFish);}
      else this.spawnClickTarget();
    };
    area.appendChild(btn);
    setTimeout(()=>{if(btn.parentNode){btn.remove();this.clickTargets=this.clickTargets.filter(x=>x!==t);this.qteProgress-=5;document.getElementById('qteBarFill').style.width=this.qteProgress+'%';if(this.qteProgress<=0)this.failQTE();else if(this.qteActive)this.spawnClickTarget();}},1500);
  }

  updateQTE() {
    if(!this.qteActive||this.qteType!=='bar')return;
    this.qteMarkerPos+=this.qteMarkerSpeed*this.qteMarkerDir;
    if(this.qteMarkerPos>=95)this.qteMarkerDir=-1;
    if(this.qteMarkerPos<=5)this.qteMarkerDir=1;
    this.qteProgress-=0.15;
    if(this.qteProgress<=0){this.failQTE();return;}
    this.updateQTEDisplay();
  }

  updateQTEDisplay() {
    document.getElementById('qteMarker').style.left=this.qteMarkerPos+'%';
    document.getElementById('qteBarFill').style.width=this.qteProgress+'%';
  }

  hookFish() {
    if(!this.qteActive||this.qteType!=='bar')return;
    const inZone=this.qteMarkerPos>=this.qteSweetStart&&this.qteMarkerPos<=this.qteSweetEnd;
    if(inZone){this.qteProgress+=15;if(this.qteProgress>=100){this.qteActive=false;document.getElementById('qteBarContainer').classList.remove('active');this.catchFish(this.qteFish);}}
    else{this.qteProgress-=10;if(this.qteProgress<=0)this.failQTE();}
    this.updateQTEDisplay();
  }

  failQTE() {
    this.qteActive=false;this.qteType='bar';
    document.getElementById('qteBarContainer').classList.remove('active');
    document.getElementById('qteClickArea').classList.remove('active');
    document.getElementById('qteClickArea').innerHTML='';
    this.clickTargets=[];
    if(this.player.bossFight){this.player.bossFight=null;}
    this.addFloatingText('💨Escaped',this.player.x,this.player.y,35,'#ff4444');
    this.glitchActive=false;this.player.fishOnLine=null;
  }

  catchFish(fish) {
    const bw=fish.weight*(0.7+Math.random()*0.6);
    let mut=null;
    for(const m of this.mutations){if(Math.random()<m.chance){mut=m;break;}}
    const w=(bw*(mut?.wMult||1)).toFixed(1);
    const vm=mut?.vMult||1;
    this.player.fishCaught++;
    this.player.gold+=Math.floor(fish.value*vm);
    this.player.discovered.add(fish.id);
    if(fish.eldritch){this.player.eldritchCaught++;if(this.player.eldritchCaught>=5&&!this.player.lovecrafted){this.player.lovecrafted=true;this.addFloatingText('🏆LOVECRAFTED!',this.player.x,this.player.y-30,100,'#ffd700');}}
    if(fish.id==='poseidonguard')this.player.perfectPearl=false;
    if(!this.player.mutationRecords[fish.id])this.player.mutationRecords[fish.id]=[];
    if(mut&&!this.player.mutationRecords[fish.id].includes(mut.name))this.player.mutationRecords[fish.id].push(mut.name);
    if(!this.player.bestWeights[fish.id]||parseFloat(w)>parseFloat(this.player.bestWeights[fish.id]))this.player.bestWeights[fish.id]=w;
    if(this.player.inOcean&&Math.random()<0.01&&this.player.pearlShards<6&&!this.player.perfectPearl){this.player.pearlShards++;this.addFloatingText('💎Shard!',this.player.x,this.player.y-20,55,'#ffd700');}
    this.player.inventory.push({fish,weight:w,mutation:mut});
    this.showCatchCard(fish,w,mut);
    this.spawnParticles(this.player.x,this.player.y,20,fish.color);
    if(fish.rarity==='Eldritch'||fish.rarity==='World Boss')this.screenShake=20;
    this.player.fishOnLine=null;this.glitchActive=false;this.updateUI();
  }

  showCatchCard(fish,w,mut) {
    const card=document.getElementById('catchCard');
    const glowColors={Common:'#a0b8c0',Uncommon:'#7c9c4a',Rare:'#e86f8a',Epic:'#c9a0ff',Legendary:'#ff8c00',Mythical:'#ff44aa','Tale Fish':'#40e0d0',Eldritch:'#2d5a27','World Boss':'#ff0000','Mythical Tale':'#4a90d9'};
    const glow=glowColors[fish.rarity]||fish.color;
    card.style.background=`linear-gradient(160deg, #0d1a2e, #162f3b)`;
    card.style.border=`3px solid ${glow}`;
    card.style.boxShadow=`0 0 30px ${glow}, 0 0 60px ${glow}44`;
    document.getElementById('catchEmoji').textContent=fish.emoji;
    document.getElementById('catchName').textContent=fish.name;
    document.getElementById('catchRarity').textContent=fish.rarity;
    document.getElementById('catchRarity').style.color=glow;
    document.getElementById('catchWeight').textContent=`${w} lbs`;
    document.getElementById('catchMutation').textContent=mut?`🧬${mut.name}`:'';
    document.getElementById('catchMutation').style.color=mut?mut.color:'#ffaa00';
    document.getElementById('catchValue').textContent=`💰${Math.floor(fish.value*(mut?.vMult||1))}`;
    card.classList.add('show');
    setTimeout(()=>card.classList.remove('show'),1500);
  }

  spawnParticles(x,y,c,color){for(let i=0;i<c;i++)this.particles.push({x,y,vx:(Math.random()-0.5)*4,vy:(Math.random()-0.5)*4-3,life:1,color,size:2+Math.random()*3});}
  addFloatingText(t,x,y,l,color){this.floatingTexts.push({text:t,x,y,life:l,max:l,color});}

  triggerBoss() {
    if(this.bossEvent||!this.player.inOcean)return;
    if(Math.random()<0.1){
      const bosses=this.fishDB.filter(f=>f.boss);
      if(bosses.length){this.bossEvent=bosses[Math.floor(Math.random()*bosses.length)];this.weather='storm';this.bossTimer=540;
        this.addFloatingText(`⚡${this.bossEvent.name}!`,450,280,100,'#ff0000');}
    }
    if(this.bossTimer>0){this.bossTimer--;if(this.bossTimer<=0){this.bossEvent=null;if(this.weather==='storm')this.weather='clear';}}
  }

  draw() {
    const ctx=this.ctx;
    ctx.clearRect(0,0,900,560);
    let sx=0,sy=0;
    if(this.screenShake>0){sx=(Math.random()-0.5)*this.screenShake;sy=(Math.random()-0.5)*this.screenShake;this.screenShake*=0.9;if(this.screenShake<0.1)this.screenShake=0;}
    if(this.glitchActive&&Math.random()<0.2){sx+=Math.random()*8-4;sy+=Math.random()*8-4;}
    ctx.save();ctx.translate(sx,sy);
    const night=Math.sin(this.dayTime*Math.PI);
    ctx.fillStyle=`rgb(${10+night*20},${15+night*30},${30+night*50})`;ctx.fillRect(0,0,900,560);
    if(this.bossEvent){ctx.fillStyle='rgba(255,0,0,0.15)';ctx.fillRect(0,0,900,560);}
    
    if(this.player.inOcean){
      ctx.fillStyle='#0a1e3a';ctx.fillRect(0,0,900,560);
      for(let i=0;i<25;i++){ctx.fillStyle=`rgba(15,50,110,${0.3+Math.sin(Date.now()*0.002+i)*0.08})`;ctx.fillRect(0,i*22+Math.sin(Date.now()*0.003+i)*4,900,11);}
    }else{
      ctx.fillStyle='#2a402a';ctx.fillRect(0,310,900,250);
      [{x:180,y:350,r:55},{x:700,y:420,r:60},{x:750,y:140,r:65}].forEach(z=>{ctx.fillStyle='rgba(20,80,160,0.8)';ctx.beginPath();ctx.arc(z.x,z.y,z.r,0,Math.PI*2);ctx.fill();});
    }
    
    ctx.fillStyle='#f5e56c';ctx.beginPath();ctx.arc(500,460,14,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='black';ctx.font='bold 8px monospace';ctx.fillText('🐟Jimmy',470,442);
    
    const bob=Math.sin(Date.now()*0.005)*2;
    ctx.fillStyle='#34c9eb';ctx.beginPath();ctx.arc(this.player.x,this.player.y+bob,12,0,Math.PI*2);ctx.fill();
    
    if(this.player.isCasting){this.player.castTimer++;
      const p=Math.min(1,this.player.castTimer/20);
      if(this.player.castTarget){const cx=this.player.x+(this.player.castTarget.x-this.player.x)*p;
        const cy=this.player.y+(this.player.castTarget.y-this.player.y)*p-Math.sin(p*Math.PI)*30;
        ctx.fillStyle='white';ctx.beginPath();ctx.arc(cx,cy,4,0,Math.PI*2);ctx.fill();
        if(p>=1){this.player.isCasting=false;this.player.waitingForBite=true;this.player.biteTimer=35+Math.random()*80;this.player.fishOnLine=this.selectFish();}}
    }
    
    if(this.player.waitingForBite&&this.player.castTarget){
      const by=this.player.castTarget.y+Math.sin(Date.now()*0.02)*5;
      ctx.fillStyle='white';ctx.beginPath();ctx.arc(this.player.castTarget.x,by,5,0,Math.PI*2);ctx.fill();
      if(this.player.biteTimer<30){ctx.fillStyle='white';ctx.font='bold 16px sans-serif';ctx.fillText('❗',this.player.castTarget.x-10,by-18);}
    }
    
    this.floatingTexts=this.floatingTexts.filter(t=>{t.life--;return t.life>0;});
    this.floatingTexts.forEach(t=>{ctx.fillStyle=t.color;ctx.font='bold 12px sans-serif';ctx.fillText(t.text,t.x-30,t.y-(t.max-t.life)*0.5);});
    this.particles=this.particles.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.life-=0.02;return p.life>0;});
    this.particles.forEach(p=>{ctx.fillStyle=p.color;ctx.globalAlpha=p.life;ctx.fillRect(p.x,p.y,p.size,p.size);});
    ctx.globalAlpha=1;ctx.restore();
  }

  update() {
    this.dayTime+=0.00025;if(this.dayTime>1)this.dayTime=0;
    this.weatherTimer++;if(this.weatherTimer>400){this.weather=['clear','rain','fog','storm','aurora'][Math.floor(Math.random()*5)];this.weatherTimer=0;}
    if(this.player.waitingForBite){this.player.biteTimer--;if(this.player.biteTimer<=0)this.fishBites();}
    if(this.qteActive&&this.qteType==='bar')this.updateQTE();
    if(!this.qteActive)this.triggerBoss();
    this.updateUI();
  }

  gameLoop() {this.update();this.draw();requestAnimationFrame(()=>this.gameLoop());}
}

const game = new Game();
</script>
