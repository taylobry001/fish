<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover">
  <title>🌊 Mythic Waters v4.0 · Smooth Fishing RPG</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      background: #0a1a2b; display:flex; justify-content:center; align-items:center; min-height:100vh;
      font-family:'Segoe UI',system-ui,sans-serif; padding:8px;
      background-image:radial-gradient(ellipse at center, #1a3a4a 0%, #0a1520 100%);
    }
    .game-container { display:flex; flex-direction:column; align-items:center; gap:6px; max-width:950px; width:100%; }
    .game-wrapper {
      background:linear-gradient(145deg, #1e3b4f 0%, #0c1f2c 100%); border-radius:28px; padding:10px;
      box-shadow:0 20px 40px rgba(0,0,0,0.7), inset 0 0 20px rgba(120,180,255,0.3); position:relative;
    }
    canvas {
      display:block; margin:0 auto; border-radius:20px; box-shadow:0 0 30px rgba(61,110,140,0.5);
      background:#1a2e3c; width:100%; height:auto; max-width:900px; aspect-ratio:16/10; cursor:crosshair;
    }
    .hud-top {
      display:flex; justify-content:space-between; padding:8px 16px; background:rgba(0,0,0,0.7);
      border-radius:20px; color:white; font-size:0.8rem; margin-bottom:6px; backdrop-filter:blur(10px);
    }
    .ui-bar {
      display:flex; justify-content:space-between; align-items:center; padding:8px 14px;
      background:rgba(10,25,35,0.85); backdrop-filter:blur(15px); border-radius:25px; margin-top:8px;
      color:#e6f7ff; flex-wrap:wrap; gap:8px; font-size:0.75rem; border:1px solid rgba(90,180,255,0.4);
    }
    button {
      background:linear-gradient(180deg, #3d6e8c 0%, #1b4057 100%); border:none; color:white;
      padding:7px 14px; border-radius:20px; font-weight:bold; cursor:pointer;
      box-shadow:0 3px 0 #102b38, 0 5px 10px rgba(0,0,0,0.5); font-size:0.7rem;
      border-bottom:2px solid #7fc9ff; white-space:nowrap; transition:all 0.1s;
    }
    button:hover { transform:translateY(-2px); }
    button:active { transform:translateY(2px); }
    .modal {
      position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
      background:linear-gradient(160deg, #0d242e, #162f3b); border:3px solid #5b9bb5;
      border-radius:20px; padding:18px; color:white; z-index:200; min-width:320px;
      max-width:500px; max-height:80vh; overflow-y:auto; display:none;
      box-shadow:0 20px 40px black;
    }
    .modal.active { display:block; animation:fadeIn 0.3s; }
    @keyframes fadeIn { from{opacity:0; transform:translate(-50%,-48%);} to{opacity:1; transform:translate(-50%,-50%);} }
    .qte-ring {
      position:fixed; bottom:40px; left:50%; transform:translateX(-50%); display:none;
      width:200px; height:200px; border-radius:50%; border:8px solid rgba(255,255,255,0.3);
      z-index:150; background:rgba(0,0,0,0.5);
    }
    .qte-ring.active { display:block; }
    .catch-card {
      position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(0);
      background:linear-gradient(160deg, #0d242e, #162f3b); border:3px solid gold;
      border-radius:20px; padding:22px; color:white; z-index:300; text-align:center;
      min-width:280px; box-shadow:0 0 40px rgba(255,215,0,0.5); transition:transform 0.3s cubic-bezier(0.68,-0.55,0.27,1.55);
    }
    .catch-card.show { transform:translate(-50%,-50%) scale(1); }
  </style>
</head>
<body>
<div class="game-container">
  <div class="hud-top">
    <span id="weatherHud">☀️ Clear</span>
    <span id="timeHud">🕐 12:00 PM</span>
    <span id="eventHud">🎣 Normal Conditions</span>
  </div>
  <div class="game-wrapper">
    <canvas id="gameCanvas" width="900" height="560"></canvas>
    <div class="ui-bar">
      <span>🎣 <span id="playerName">Angler</span></span>
      <span>🐟 <span id="fishCount">0</span></span>
      <span>💰 <span id="goldDisplay">150</span></span>
      <span>🚤 <span id="boatStatus">No Boat</span></span>
      <button id="fishBioBtn">📖 FishBio</button>
      <button id="shopBtn">🏪 Jimmy</button>
      <input id="roomInput" style="width:70px;background:#172d39;border:1px solid #4682b4;border-radius:15px;padding:5px;color:white;" value="reef">
      <button id="joinBtn">🌐 Join</button>
    </div>
  </div>
  <div style="color:#b6d9f0;font-size:0.65rem;">🖱️ Click water to cast · SPACE to hook fish · 🚤 Buy boat from Jimmy (1000💰)</div>
</div>

<!-- FishBio Modal -->
<div id="fishBioModal" class="modal">
  <span onclick="this.parentElement.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🐠 FishBio</h3>
  <div id="bioGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0;"></div>
  <p>Discovered: <span id="bioCount">0</span>/15</p>
</div>

<!-- Jimmy Shop Modal -->
<div id="shopModal" class="modal">
  <span onclick="this.parentElement.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🏪 Fishin Jimmy's Shop</h3>
  <p id="jimmyDialogue" style="color:#ffd966;">"Welcome, partner!"</p>
  <div style="display:flex;gap:8px;margin:10px 0;">
    <button onclick="sellAllFish()">💰 Sell All Fish</button>
    <button onclick="buyBoat()">🚤 Buy Boat (1000💰)</button>
  </div>
  <p style="font-size:0.7rem;">Inventory: <span id="invCount">0</span> fish</p>
</div>

<!-- QTE Ring -->
<div class="qte-ring" id="qteRing">
  <canvas id="qteCanvas" width="200" height="200"></canvas>
</div>

<!-- Catch Card -->
<div class="catch-card" id="catchCard">
  <div id="catchEmoji" style="font-size:3rem;">🐟</div>
  <h2 id="catchName">Fish</h2>
  <div id="catchRarity" style="color:#ffd966;">Common</div>
  <div id="catchWeight">0.0 lbs</div>
  <div id="catchMutation" style="color:#ffaa00;"></div>
  <div id="catchValue">💰 0</div>
</div>

<script>
(function(){
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  const qteCanvas = document.getElementById('qteCanvas');
  const qteCtx = qteCanvas.getContext('2d');

  // ============ PLAYER ============
  const player = {
    x:400, y:350, speed:2.8, name:'Angler'+Math.floor(Math.random()*1000),
    gold:150, fishCaught:0, inventory:[], discovered:new Set(),
    mutationRecords:{}, bestWeights:{},
    boatOwned:false, inOcean:false,
    isCasting:false, castTarget:null, castTimer:0,
    fishOnLine:null, waitingForBite:false, biteTimer:0,
  };

  // ============ WORLD ============
  const waterZones = [
    { x:180, y:350, r:55, type:'lake', name:'Misty Lake', fishTypes:['bluegill','bass','catfish'] },
    { x:700, y:420, r:60, type:'river', name:'Silver River', fishTypes:['trout','salmon','bass'] },
    { x:750, y:140, r:65, type:'ocean', name:'Deep Ocean', fishTypes:['glimmerfin','stormwhale','marlin'] },
  ];
  let oceanZones = [];
  const jimmy = { x:500, y:460, name:'Fishin Jimmy' };
  const shoreline = [
    {x1:0,y1:310,x2:300,y2:310},{x1:600,y1:310,x2:900,y2:310},
    {x1:150,y1:310,x2:150,y2:350},{x1:250,y1:310,x2:250,y2:350},
    {x1:680,y1:310,x2:680,y2:420},{x1:760,y1:310,x2:760,y2:420},
  ];

  // ============ DYNAMIC ============
  let dayTime=0.5, weather='clear', weatherTimer=0;
  let particles=[], floatingTexts=[], screenShake=0;
  let qteActive=false, qteProgress=0.5, qteMarker=0.5, qteDir=0.02;
  let qteFish=null, qtePhase=0;
  let catchCardTimer=0;
  let multiplayerPlayers=[];

  // ============ FISH DATABASE ============
  const fishDB = [
    {id:'bluegill',name:'Bluegill',rarity:'Common',weight:1.5,value:10,emoji:'🐟',color:'#a0b8c0',qte:'easy'},
    {id:'bass',name:'Largemouth Bass',rarity:'Uncommon',weight:3.2,value:28,emoji:'🐠',color:'#7c9c4a',qte:'easy'},
    {id:'catfish',name:'Channel Catfish',rarity:'Common',weight:4.1,value:15,emoji:'🐡',color:'#8b7355',qte:'easy'},
    {id:'trout',name:'Rainbow Trout',rarity:'Rare',weight:5.8,value:65,emoji:'🐟',color:'#e86f8a',qte:'medium'},
    {id:'salmon',name:'King Salmon',rarity:'Rare',weight:12.3,value:80,emoji:'🐠',color:'#ff6347',qte:'medium'},
    {id:'marlin',name:'Blue Marlin',rarity:'Epic',weight:35.0,value:200,emoji:'🐋',color:'#4169e1',qte:'medium'},
    {id:'glimmerfin',name:'Glimmerfin',rarity:'Epic',weight:18.5,value:150,emoji:'🦑',color:'#c9a0ff',qte:'medium',weather:'aurora'},
    {id:'stormwhale',name:'Storm Whale',rarity:'Legendary',weight:55.0,value:500,emoji:'🐳',color:'#4a6fa5',qte:'hard',weather:'storm'},
    {id:'moonserpent',name:'Moon Serpent',rarity:'Mythical',weight:85.0,value:900,emoji:'🐉',color:'#f0e68c',qte:'hard',time:'night'},
    {id:'tidewraith',name:'Tide Wraith',rarity:'Tale Fish',weight:130.0,value:2000,emoji:'👻',color:'#40e0d0',qte:'extreme',weather:'fog',time:'night'},
    {id:'sunfish',name:'Ocean Sunfish',rarity:'Uncommon',weight:8.2,value:35,emoji:'🌞',color:'#ffd700',qte:'easy'},
    {id:'pike',name:'Northern Pike',rarity:'Uncommon',weight:6.7,value:40,emoji:'🐊',color:'#556b2f',qte:'easy'},
    {id:'carp',name:'Golden Carp',rarity:'Rare',weight:9.4,value:70,emoji:'✨',color:'#ffd700',qte:'medium'},
    {id:'angler',name:'Anglerfish',rarity:'Epic',weight:22.0,value:180,emoji:'👾',color:'#2f4f4f',qte:'medium',time:'night'},
    {id:'kraken',name:'Baby Kraken',rarity:'Mythical',weight:95.0,value:850,emoji:'🐙',color:'#8b008b',qte:'hard',weather:'storm'},
  ];

  const mutations = [
    {name:'Alpha',color:'#ff4444',mult:2.0},{name:'Golden',color:'#ffd700',mult:3.0},
    {name:'Radioactive',color:'#00ff00',mult:2.5},{name:'Frostbitten',color:'#00ffff',mult:2.2},
    {name:'Giant',color:'#ff8c00',mult:4.0},{name:'Albino',color:'#ffffff',mult:3.5},
    {name:'Shadow',color:'#333333',mult:2.8},{name:'Predator',color:'#ff0000',mult:5.0},
  ];

  // ============ UI ============
  function updateUI(){
    document.getElementById('playerName').textContent=player.name.substring(0,10);
    document.getElementById('fishCount').textContent=player.fishCaught;
    document.getElementById('goldDisplay').textContent=player.gold;
    document.getElementById('boatStatus').textContent=player.boatOwned?'⛵ Boat':'❌ No Boat';
    const wEmoji={clear:'☀️',rain:'🌧️',fog:'🌫️',storm:'⛈️',aurora:'🌌'};
    document.getElementById('weatherHud').textContent=`${wEmoji[weather]} ${weather}`;
    const hours=Math.floor(dayTime*24);
    document.getElementById('timeHud').textContent=`🕐 ${hours}:00 ${dayTime>0.25&&dayTime<0.75?'AM':'PM'}`;
    document.getElementById('eventHud').textContent=weather!=='clear'?`⚡ ${weather} event active!`:'🎣 Normal';
  }

  // ============ FISHBIO ============
  function openFishBio(){
    const grid=document.getElementById('bioGrid');
    grid.innerHTML='';
    fishDB.forEach(f=>{
      const d=player.discovered.has(f.id);
      const div=document.createElement('div');
      div.style.cssText=`background:#162f3b;padding:8px;border-radius:10px;font-size:0.65rem;border-left:4px solid ${d?f.color:'#555'};opacity:${d?1:0.5}`;
      div.innerHTML=`<strong>${d?f.emoji+' '+f.name:'???'}</strong><br>${f.rarity} · ${f.weight}lbs`;
      grid.appendChild(div);
    });
    document.getElementById('bioCount').textContent=player.discovered.size;
    document.getElementById('fishBioModal').classList.add('active');
  }

  document.getElementById('fishBioBtn').addEventListener('click',openFishBio);

  // ============ JIMMY SHOP ============
  function openShop(){
    document.getElementById('invCount').textContent=player.inventory.length;
    const jokes=["Nice hat! Oh wait...","I once caught a whale with a toothpick!","Legend says the Tide Wraith appears in fog...","You're my best customer! (You're also my only customer.)"];
    document.getElementById('jimmyDialogue').textContent=jokes[Math.floor(Math.random()*jokes.length)];
    document.getElementById('shopModal').classList.add('active');
  }
  document.getElementById('shopBtn').addEventListener('click',openShop);

  function sellAllFish(){
    const total=player.inventory.reduce((s,item)=>s+Math.floor(item.fish.value*(item.mutation?.mult||1)),0);
    player.gold+=total; player.inventory=[];
    document.getElementById('invCount').textContent='0';
    updateUI();
    floatingTexts.push({text:`💰 Sold for ${total}!`,x:player.x,y:player.y-20,life:50,color:'#ffd700'});
  }

  function buyBoat(){
    if(!player.boatOwned&&player.gold>=1000){player.boatOwned=true;player.gold-=1000;updateUI();
      floatingTexts.push({text:'🚤 Boat purchased!',x:player.x,y:player.y-20,life:50,color:'#ffd700'});}
    else if(player.boatOwned){floatingTexts.push({text:'Already own a boat!',x:player.x,y:player.y-20,life:40,color:'#ffaa00'});}
    else{floatingTexts.push({text:'Need 1000 coins!',x:player.x,y:player.y-20,life:40,color:'#ff4444'});}
  }

  // ============ WATER COLLISION ============
  function isInWater(x,y){
    return waterZones.some(z=>Math.hypot(x-z.x,y-z.y)<z.r);
  }

  function canWalkTo(nx,ny){
    if(player.boatOwned&&player.inOcean)return true;
    if(isInWater(nx,ny))return false;
    // Check shoreline
    for(let s of shoreline){
      const dist=Math.abs((s.x2-s.x1)*(s.y1-ny)-(s.x1-nx)*(s.y2-s.y1))/Math.hypot(s.x2-s.x1,s.y2-s.y1);
      if(dist<15)return false;
    }
    return true;
  }

  // ============ FISHING ============
  function castLine(tx,ty){
    if(player.waitingForBite||player.fishOnLine||qteActive)return;
    const zones=player.inOcean?oceanZones:waterZones;
    const spot=zones.find(z=>Math.hypot(tx-z.x,ty-z.y)<z.r);
    if(!spot)return;
    
    player.isCasting=true;
    player.castTarget={x:tx,y:ty,spot:spot};
    player.castTimer=0;
    floatingTexts.push({text:'🎣 Cast!',x:player.x,y:player.y-15,life:30,color:'#ffffff'});
    spawnParticles(tx,ty,8,'#87ceeb');
  }

  function startWaitingForBite(spot){
    player.waitingForBite=true;
    player.biteTimer=60+Math.random()*120; // 3-8 seconds at 60fps
    const fish=selectFish(spot);
    player.fishOnLine=fish;
  }

  function selectFish(spot){
    let available=fishDB.filter(f=>{
      if(f.weather&&weather!==f.weather)return false;
      if(f.time==='night'&&dayTime>0.25&&dayTime<0.75)return false;
      if(f.time==='day'&&(dayTime<0.25||dayTime>0.75))return false;
      return true;
    });
    if(available.length===0)available=fishDB;
    const weights={Common:50,Uncommon:25,Rare:15,Epic:7,Legendary:2,Mythical:0.8,'Tale Fish':0.2};
    let total=0;
    const w=available.map(f=>({f,w:weights[f.rarity]||1}));
    total=w.reduce((s,i)=>s+i.w,0);
    let r=Math.random()*total;
    for(let i of w){r-=i.w;if(r<=0)return i.f;}
    return available[0];
  }

  function fishBites(){
    player.waitingForBite=false;
    const fish=player.fishOnLine;
    if(!fish)return;
    floatingTexts.push({text:'❗ FISH!',x:player.x,y:player.y-25,life:40,color:'#ff4444'});
    screenShake=8;
    spawnParticles(player.x,player.y-10,12,'#ffaa00');
    
    if(fish.qte==='easy')startQTE(fish,0.4,0.015);
    else if(fish.qte==='medium')startQTE(fish,0.55,0.022);
    else if(fish.qte==='hard')startQTE(fish,0.7,0.03);
    else startQTE(fish,0.85,0.04);
  }

  function startQTE(fish,difficulty,speed){
    qteActive=true; qteFish=fish; qteProgress=0.5; qteMarker=0.5; qteDir=speed;
    qtePhase=0;
    document.getElementById('qteRing').classList.add('active');
  }

  function updateQTE(){
    if(!qteActive)return;
    qteMarker+=qteDir;
    if(qteMarker>0.85||qteMarker<0.15)qteDir*=-1;
    
    // Draw QTE ring
    qteCtx.clearRect(0,0,200,200);
    qteCtx.beginPath(); qteCtx.arc(100,100,80,0,Math.PI*2);
    qteCtx.strokeStyle='rgba(255,255,255,0.3)'; qteCtx.lineWidth=10; qteCtx.stroke();
    
    // Green zone
    const zoneSize=0.3-(qteFish?.qte==='extreme'?0.15:0);
    qteCtx.beginPath();
    qteCtx.arc(100,100,80,-Math.PI/2+zoneSize*Math.PI*2,-Math.PI/2-zoneSize*Math.PI*2,true);
    qteCtx.strokeStyle='#4caf92'; qteCtx.lineWidth=10; qteCtx.stroke();
    
    // Marker
    const angle=-Math.PI/2+qteMarker*Math.PI*2;
    qteCtx.beginPath(); qteCtx.arc(100+Math.cos(angle)*80,100+Math.sin(angle)*80,8,0,Math.PI*2);
    qteCtx.fillStyle='gold'; qteCtx.fill();
  }

  function hookFish(){
    if(!qteActive)return;
    const inZone=qteMarker>0.25&&qteMarker<0.45;
    if(inZone){
      qteProgress+=0.2;
      if(qteProgress>=1){
        qteActive=false;
        document.getElementById('qteRing').classList.remove('active');
        catchFishSuccess(qteFish);
      }
    }else{
      qteProgress-=0.15;
      if(qteProgress<=0){
        qteActive=false;
        document.getElementById('qteRing').classList.remove('active');
        floatingTexts.push({text:'💨 Escaped!',x:player.x,y:player.y,life:40,color:'#ff4444'});
        player.fishOnLine=null;
      }
    }
  }

  function catchFishSuccess(fish){
    const weight=(fish.weight*(0.7+Math.random()*0.6)).toFixed(1);
    let mutation=null;
    if(Math.random()<0.1)mutation=mutations[Math.floor(Math.random()*mutations.length)];
    
    player.fishCaught++;
    player.gold+=Math.floor(fish.value*(mutation?.mult||1));
    player.discovered.add(fish.id);
    if(!player.mutationRecords[fish.id])player.mutationRecords[fish.id]=[];
    if(mutation&&!player.mutationRecords[fish.id].includes(mutation.name))player.mutationRecords[fish.id].push(mutation.name);
    if(!player.bestWeights[fish.id]||weight>player.bestWeights[fish.id])player.bestWeights[fish.id]=weight;
    
    player.inventory.push({fish,weight,mutation});
    showCatchCard(fish,weight,mutation);
    spawnParticles(player.x,player.y,20,fish.color);
    if(fish.rarity==='Tale Fish')screenShake=25;
    player.fishOnLine=null;
    updateUI();
  }

  function showCatchCard(fish,weight,mutation){
    const card=document.getElementById('catchCard');
    document.getElementById('catchEmoji').textContent=fish.emoji;
    document.getElementById('catchName').textContent=fish.name;
    document.getElementById('catchRarity').textContent=fish.rarity;
    document.getElementById('catchRarity').style.color=fish.color;
    document.getElementById('catchWeight').textContent=`${weight} lbs`;
    document.getElementById('catchMutation').textContent=mutation?`🧬 ${mutation.name}`:'';
    document.getElementById('catchValue').textContent=`💰 ${Math.floor(fish.value*(mutation?.mult||1))}`;
    card.classList.add('show');
    catchCardTimer=100;
    setTimeout(()=>card.classList.remove('show'),2500);
  }

  // ============ PARTICLES ============
  function spawnParticles(x,y,count,color){
    for(let i=0;i<count;i++)particles.push({x,y,vx:(Math.random()-0.5)*3,vy:(Math.random()-0.5)*3-2,life:1,color,size:2+Math.random()*3});
  }

  // ============ OCEAN ============
  function generateOcean(){
    oceanZones=[];
    for(let i=0;i<15;i++)oceanZones.push({x:100+Math.random()*700,y:50+Math.random()*450,r:35+Math.random()*25,type:'ocean'});
  }

  // ============ MULTIPLAYER ============
  function syncPlayers(){
    const data=JSON.parse(localStorage.getItem('mythic_room_'+document.getElementById('roomInput').value)||'{}');
    data[player.name]={x:player.x,y:player.y,name:player.name,time:Date.now()};
    localStorage.setItem('mythic_room_'+document.getElementById('roomInput').value,JSON.stringify(data));
    multiplayerPlayers=Object.values(data).filter(p=>p.name!==player.name&&Date.now()-p.time<10000);
  }

  document.getElementById('joinBtn').addEventListener('click',()=>{
    document.getElementById('roomInput').value=document.getElementById('roomInput').value||'reef';
    syncPlayers();
  });

  // ============ RENDER ============
  function draw(){
    ctx.clearRect(0,0,900,560);
    let sx=0,sy=0;
    if(screenShake>0){sx=(Math.random()-0.5)*screenShake;sy=(Math.random()-0.5)*screenShake;screenShake*=0.9;if(screenShake<0.1)screenShake=0;}
    ctx.save(); ctx.translate(sx,sy);
    
    // Sky
    const night=Math.sin(dayTime*Math.PI);
    ctx.fillStyle=`rgb(${20+night*30},${30+night*50},${60+night*70})`;
    ctx.fillRect(0,0,900,560);
    
    // Ground
    ctx.fillStyle='#3b5e3b'; ctx.fillRect(0,310,900,250);
    
    // Water
    const zones=player.inOcean?oceanZones:waterZones;
    zones.forEach(z=>{
      const g=ctx.createRadialGradient(z.x,z.y,z.r*0.2,z.x,z.y,z.r);
      g.addColorStop(0,'rgba(30,100,180,0.9)'); g.addColorStop(1,'rgba(10,50,100,0.7)');
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(z.x,z.y,z.r,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle='rgba(255,255,255,0.2)';
      for(let w=0;w<2;w++){ctx.beginPath();ctx.arc(z.x,z.y,z.r-5-w*8+Math.sin(Date.now()*0.003+w)*3,0,Math.PI*2);ctx.stroke();}
    });
    
    // Jimmy
    ctx.fillStyle='#f5e56c'; ctx.shadowColor='#ffaa00'; ctx.shadowBlur=12;
    ctx.beginPath(); ctx.arc(jimmy.x,jimmy.y,14,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0; ctx.fillStyle='black'; ctx.font='bold 9px monospace';
    ctx.fillText('🐟 Jimmy',jimmy.x-30,jimmy.y-18);
    
    // Multiplayer players
    multiplayerPlayers.forEach(p=>{
      ctx.fillStyle='#ffb347'; ctx.beginPath(); ctx.arc(p.x,p.y,10,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='white'; ctx.font='8px sans-serif'; ctx.fillText(p.name,p.x-15,p.y-15);
    });
    
    // Player with bob animation
    const bob=Math.sin(Date.now()*0.005)*2;
    ctx.fillStyle='#34c9eb'; ctx.shadowColor='#a0e0ff'; ctx.shadowBlur=14;
    ctx.beginPath(); ctx.arc(player.x,player.y+bob,12,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
    
    // Cast animation
    if(player.isCasting){
      player.castTimer++;
      const progress=Math.min(1,player.castTimer/30);
      if(player.castTarget){
        const cx=player.x+(player.castTarget.x-player.x)*progress;
        const cy=player.y+(player.castTarget.y-player.y)*progress-Math.sin(progress*Math.PI)*30;
        ctx.fillStyle='#ff4444'; ctx.beginPath(); ctx.arc(cx,cy,5,0,Math.PI*2); ctx.fill();
        if(progress>=1){player.isCasting=false;startWaitingForBite(player.castTarget.spot);}
      }
    }
    
    // Waiting for bite indicator
    if(player.waitingForBite&&player.castTarget){
      const t=player.castTarget;
      const bobberY=t.y+Math.sin(Date.now()*0.01)*5;
      ctx.fillStyle='#ff4444'; ctx.beginPath(); ctx.arc(t.x,bobberY,5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='white'; ctx.font='bold 14px sans-serif';
      if(player.biteTimer<30)ctx.fillText('❗',t.x-8,bobberY-15);
    }
    
    // Floating texts
    floatingTexts=floatingTexts.filter(t=>{t.life--;return t.life>0;});
    floatingTexts.forEach(t=>{
      ctx.fillStyle=t.color; ctx.font='bold 14px sans-serif';
      ctx.fillText(t.text,t.x-30,t.y-(60-t.life)*0.5);
    });
    
    // Particles
    particles=particles.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.life-=0.02;return p.life>0;});
    particles.forEach(p=>{ctx.fillStyle=p.color;ctx.globalAlpha=p.life;ctx.fillRect(p.x,p.y,p.size,p.size);});
    ctx.globalAlpha=1;
    
    ctx.restore();
  }

  // ============ GAME LOOP ============
  function update(){
    dayTime+=0.0003; if(dayTime>1)dayTime=0;
    weatherTimer++; if(weatherTimer>400){weather=['clear','rain','fog','storm','aurora'][Math.floor(Math.random()*5)];weatherTimer=0;}
    
    if(player.waitingForBite){
      player.biteTimer--;
      if(player.biteTimer<=0)fishBites();
    }
    
    updateQTE();
    if(catchCardTimer>0)catchCardTimer--;
    updateUI();
  }

  function gameLoop(){
    update(); draw();
    requestAnimationFrame(gameLoop);
  }

  // ============ CONTROLS ============
  const keys={};
  canvas.addEventListener('click',e=>{
    const rect=canvas.getBoundingClientRect();
    const mx=(e.clientX-rect.left)*(900/rect.width);
    const my=(e.clientY-rect.top)*(560/rect.height);
    
    // Jimmy interaction
    if(Math.hypot(mx-jimmy.x,my-jimmy.y)<30){openShop();return;}
    
    // Cast line
    if(!qteActive&&!player.waitingForBite&&!player.fishOnLine){
      castLine(mx,my);
    }
  });

  window.addEventListener('keydown',e=>{
    keys[e.code]=true;
    if(e.code==='Space'){
      e.preventDefault();
      if(qteActive)hookFish();
      else if(player.boatOwned&&!player.waitingForBite){
        player.inOcean=!player.inOcean;
        if(player.inOcean&&oceanZones.length===0)generateOcean();
        floatingTexts.push({text:player.inOcean?'🌊 Ocean!':'🏝️ Island',x:player.x,y:player.y-20,life:40,color:'#7fc9ff'});
      }
    }
  });
  window.addEventListener('keyup',e=>{keys[e.code]=false;});

  // Movement
  setInterval(()=>{
    if(qteActive)return;
    let dx=0,dy=0;
    if(keys['KeyW']||keys['ArrowUp'])dy--;
    if(keys['KeyS']||keys['ArrowDown'])dy++;
    if(keys['KeyA']||keys['ArrowLeft'])dx--;
    if(keys['KeyD']||keys['ArrowRight'])dx++;
    if(dx||dy){
      const len=Math.sqrt(dx*dx+dy*dy);
      const nx=player.x+dx/len*player.speed;
      const ny=player.y+dy/len*player.speed;
      if(canWalkTo(nx,ny)){player.x=nx;player.y=ny;}
    }
  },16);

  // Sync multiplayer
  setInterval(syncPlayers,2000);

  // Initialize
  updateUI();
  if(player.boatOwned&&oceanZones.length===0)generateOcean();
  gameLoop();
})();
</script>
</body>
</html>
