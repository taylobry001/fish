<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover">
  <title>🌊 Mythic Waters v5.1 · Fixed QTE</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      background: #0a0a1a; display:flex; justify-content:center; align-items:center; min-height:100vh;
      font-family:'Segoe UI',system-ui,sans-serif; padding:8px;
      background-image:radial-gradient(ellipse at center, #1a1a3a 0%, #0a0a1a 100%);
    }
    .game-container { display:flex; flex-direction:column; align-items:center; gap:6px; max-width:950px; width:100%; }
    .game-wrapper {
      background:linear-gradient(145deg, #1e2e4f 0%, #0c1a2c 100%); border-radius:28px; padding:10px;
      box-shadow:0 20px 40px rgba(0,0,0,0.8), inset 0 0 20px rgba(100,150,255,0.2); position:relative;
    }
    canvas {
      display:block; margin:0 auto; border-radius:20px; box-shadow:0 0 30px rgba(61,110,140,0.5);
      background:#1a2e3c; width:100%; height:auto; max-width:900px; aspect-ratio:16/10; cursor:crosshair;
    }
    .hud-top {
      display:flex; justify-content:space-between; padding:8px 16px; background:rgba(0,0,0,0.8);
      border-radius:20px; color:white; font-size:0.75rem; margin-bottom:6px; backdrop-filter:blur(10px);
      border:1px solid rgba(100,150,255,0.3); flex-wrap:wrap; gap:4px;
    }
    .ui-bar {
      display:flex; justify-content:space-between; align-items:center; padding:8px 14px;
      background:rgba(10,20,35,0.9); backdrop-filter:blur(15px); border-radius:25px; margin-top:8px;
      color:#e6f7ff; flex-wrap:wrap; gap:8px; font-size:0.7rem; border:1px solid rgba(80,160,255,0.4);
    }
    button {
      background:linear-gradient(180deg, #3d6e8c 0%, #1b4057 100%); border:none; color:white;
      padding:7px 14px; border-radius:20px; font-weight:bold; cursor:pointer;
      box-shadow:0 3px 0 #0f1e2e, 0 5px 10px rgba(0,0,0,0.5); font-size:0.65rem;
      border-bottom:2px solid #7fc9ff; white-space:nowrap; transition:all 0.1s;
    }
    button:hover { transform:translateY(-2px); }
    button:active { transform:translateY(2px); }
    .modal {
      position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
      background:linear-gradient(160deg, #0d1a2e, #162a3b); border:3px solid #5b9bb5;
      border-radius:20px; padding:18px; color:white; z-index:200; min-width:320px;
      max-width:500px; max-height:80vh; overflow-y:auto; display:none;
      box-shadow:0 20px 40px black;
    }
    .modal.active { display:block; animation:fadeIn 0.3s; }
    @keyframes fadeIn { from{opacity:0; transform:translate(-50%,-48%);} to{opacity:1; transform:translate(-50%,-50%);} }
    
    /* SIMPLIFIED QTE BAR */
    .qte-bar-container {
      position:fixed; bottom:80px; left:50%; transform:translateX(-50%); display:none;
      width:400px; height:50px; background:rgba(0,0,0,0.8); border-radius:25px;
      z-index:150; border:3px solid #555; overflow:hidden;
    }
    .qte-bar-container.active { display:block; }
    .qte-bar-fill {
      height:100%; background:linear-gradient(90deg, #ff4444 0%, #4caf92 50%, #ff4444 100%);
      transition:width 0.1s;
    }
    .qte-marker {
      position:absolute; top:-5px; width:6px; height:60px; background:gold;
      box-shadow:0 0 15px gold; border-radius:3px;
    }
    .qte-target-zone {
      position:absolute; top:0; height:100%; background:rgba(76,175,146,0.3);
      border-left:2px solid #4caf92; border-right:2px solid #4caf92;
    }
    
    .boss-healthbar {
      position:fixed; top:20px; left:50%; transform:translateX(-50%); width:400px; height:30px;
      background:#1a1a1a; border:3px solid #ff4444; border-radius:12px; display:none; z-index:250;
    }
    .boss-healthbar.active { display:block; }
    .boss-fill { height:100%; background:linear-gradient(90deg,#ff4444,#ff8888); border-radius:8px; transition:width 0.3s; }
    .catch-card {
      position:fixed; top:50%; left:50%; transform:translate(-50%,-50%) scale(0);
      background:linear-gradient(160deg, #0d1a2e, #162a3b); border:3px solid gold;
      border-radius:20px; padding:22px; color:white; z-index:300; text-align:center;
      min-width:280px; box-shadow:0 0 40px rgba(255,215,0,0.5); transition:transform 0.3s cubic-bezier(0.68,-0.55,0.27,1.55);
    }
    .catch-card.show { transform:translate(-50%,-50%) scale(1); }
  </style>
</head>
<body>
<div class="game-container">
  <div class="hud-top">
    <span id="weatherHud">☀️ Clear</span>
    <span id="timeHud">🕐 12:00</span>
    <span id="eventHud">🎣 Normal</span>
    <span id="pearlHud">💎 0/6 Pearls</span>
    <span id="eldritchHud">👁️ 0/5 Eldritch</span>
  </div>
  <div class="game-wrapper">
    <canvas id="gameCanvas" width="900" height="560"></canvas>
    <div class="ui-bar">
      <span>🎣 <span id="playerName">Angler</span></span>
      <span>🐟 <span id="fishCount">0</span></span>
      <span>💰 <span id="goldDisplay">150</span></span>
      <span>🚤 <span id="boatStatus">No Boat</span></span>
      <button id="fishBioBtn">📖 FishBio</button>
      <button id="shopBtn">🏪 Jimmy</button>
      <input id="roomInput" style="width:60px;background:#172d39;border:1px solid #4682b4;border-radius:12px;padding:4px;color:white;font-size:0.6rem;" value="abyss">
      <button id="joinBtn">🌐 Join</button>
    </div>
  </div>
  <div style="color:#b6d9f0;font-size:0.6rem;">🖱️ Click water to cast · SPACE when marker in GREEN zone · 🚤 Boat from Jimmy (1000💰)</div>
</div>

<!-- FishBio Modal -->
<div id="fishBioModal" class="modal">
  <span onclick="this.parentElement.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🐠 FishBio · <span id="bioCount">0</span>/25</h3>
  <div id="bioGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:10px 0;max-height:350px;overflow-y:auto;"></div>
</div>

<!-- Jimmy Shop Modal -->
<div id="shopModal" class="modal">
  <span onclick="this.parentElement.classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🏪 Fishin Jimmy's Shop</h3>
  <p id="jimmyDialogue" style="color:#ffd966;">"Welcome, partner!"</p>
  <div style="display:flex;gap:6px;margin:10px 0;flex-wrap:wrap;">
    <button onclick="sellAllFish()">💰 Sell All Fish</button>
    <button onclick="buyBoat()">🚤 Buy Boat (1000💰)</button>
    <button id="craftPearlBtn" onclick="craftPearl()" style="display:none;">💎 Craft Perfect Pearl</button>
  </div>
  <p style="font-size:0.65rem;">Inventory: <span id="invCount">0</span> fish · Pearls: <span id="shopPearls">0</span>/6</p>
</div>

<!-- SIMPLIFIED QTE BAR -->
<div class="qte-bar-container" id="qteBarContainer">
  <div class="qte-target-zone" id="qteTargetZone" style="left:35%;width:30%;"></div>
  <div class="qte-marker" id="qteMarker" style="left:50%;"></div>
  <div class="qte-bar-fill" id="qteBarFill" style="width:50%;"></div>
</div>

<!-- Boss Health Bar -->
<div class="boss-healthbar" id="bossBar">
  <div class="boss-fill" id="bossFill" style="width:100%"></div>
</div>

<!-- Catch Card -->
<div class="catch-card" id="catchCard">
  <div id="catchEmoji" style="font-size:3rem;">🐟</div>
  <h2 id="catchName">Fish</h2>
  <div id="catchRarity" style="color:#ffd966;">Common</div>
  <div id="catchWeight">0.0 lbs</div>
  <div id="catchMutation" style="color:#ffaa00;"></div>
  <div id="catchValue">💰 0</div>
</div>

<script>
(function(){
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');

  // ============ PLAYER ============
  const player = {
    x:400, y:350, speed:2.8, name:'Angler'+Math.floor(Math.random()*1000),
    gold:150, fishCaught:0, inventory:[], discovered:new Set(),
    mutationRecords:{}, bestWeights:{},
    boatOwned:false, inOcean:false,
    isCasting:false, castTarget:null, castTimer:0,
    fishOnLine:null, waitingForBite:false, biteTimer:0,
    pearlShards:0, perfectPearl:false,
    eldritchCaught:0, lovecraftedAchievement:false,
    bossFight:null,
  };

  // ============ WORLD ============
  const waterZones = [
    { x:180, y:350, r:55, type:'lake', name:'Misty Lake' },
    { x:700, y:420, r:60, type:'river', name:'Silver River' },
    { x:750, y:140, r:65, type:'ocean', name:'Deep Ocean' },
  ];
  let oceanZones = [];
  const jimmy = { x:500, y:460, name:'Fishin Jimmy' };

  // ============ DYNAMIC ============
  let dayTime=0.5, weather='clear', weatherTimer=0;
  let particles=[], floatingTexts=[], screenShake=0, glitchActive=false;
  
  // SIMPLIFIED QTE SYSTEM
  let qteActive=false;
  let qteMarkerPos=50; // Position as percentage (0-100)
  let qteMarkerSpeed=1.5; // How fast the marker moves
  let qteMarkerDirection=1; // 1 = right, -1 = left
  let qteProgress=50; // Progress as percentage (0-100)
  let qteFish=null;
  let qteGreenStart=35; // Green zone start percentage
  let qteGreenEnd=65; // Green zone end percentage
  
  let catchCardTimer=0;
  let multiplayerPlayers=[];
  let bossEvent=null;

  // ============ EXPANDED FISH DATABASE ============
  const fishDB = [
    // Common - Uncommon (instant catch, no QTE)
    {id:'bluegill',name:'Bluegill',rarity:'Common',weight:1.5,value:10,emoji:'🐟',color:'#a0b8c0',qte:false},
    {id:'bass',name:'Largemouth Bass',rarity:'Uncommon',weight:3.2,value:28,emoji:'🐠',color:'#7c9c4a',qte:false},
    {id:'catfish',name:'Channel Catfish',rarity:'Common',weight:4.1,value:15,emoji:'🐡',color:'#8b7355',qte:false},
    {id:'sunfish',name:'Ocean Sunfish',rarity:'Uncommon',weight:8.2,value:35,emoji:'🌞',color:'#ffd700',qte:false},
    {id:'pike',name:'Northern Pike',rarity:'Uncommon',weight:6.7,value:40,emoji:'🐊',color:'#556b2f',qte:false},
    // Rare - Epic (QTE with wider green zone)
    {id:'trout',name:'Rainbow Trout',rarity:'Rare',weight:5.8,value:65,emoji:'🐟',color:'#e86f8a',qte:'easy'},
    {id:'salmon',name:'King Salmon',rarity:'Rare',weight:12.3,value:80,emoji:'🐠',color:'#ff6347',qte:'easy'},
    {id:'carp',name:'Golden Carp',rarity:'Rare',weight:9.4,value:70,emoji:'✨',color:'#ffd700',qte:'easy'},
    {id:'marlin',name:'Blue Marlin',rarity:'Epic',weight:35.0,value:200,emoji:'🐋',color:'#4169e1',qte:'medium'},
    {id:'glimmerfin',name:'Glimmerfin',rarity:'Epic',weight:18.5,value:150,emoji:'🦑',color:'#c9a0ff',qte:'medium',weather:'aurora'},
    {id:'angler',name:'Anglerfish',rarity:'Epic',weight:22.0,value:180,emoji:'👾',color:'#2f4f4f',qte:'medium',time:'night'},
    // Legendary - Mythical (harder QTE)
    {id:'stormwhale',name:'Storm Whale',rarity:'Legendary',weight:55.0,value:500,emoji:'🐳',color:'#4a6fa5',qte:'hard',weather:'storm'},
    {id:'moonserpent',name:'Moon Serpent',rarity:'Mythical',weight:85.0,value:900,emoji:'🐉',color:'#f0e68c',qte:'hard',time:'night'},
    {id:'kraken',name:'Baby Kraken',rarity:'Mythical',weight:95.0,value:850,emoji:'🐙',color:'#8b008b',qte:'hard',weather:'storm'},
    // Tale Fish (very hard QTE)
    {id:'tidewraith',name:'Tide Wraith',rarity:'Tale Fish',weight:130.0,value:2000,emoji:'👻',color:'#40e0d0',qte:'extreme',weather:'fog',time:'night'},
    // ELDRITCH ABYSSAL FISH
    {id:'cthulhu',name:'Cthulhu, The Deep One',rarity:'Eldritch',weight:200,value:5000,emoji:'🐙',color:'#2d5a27',qte:'extreme',eldritch:true,lore:'Ph\'nglui mglw\'nafh Cthulhu R\'lyeh wgah\'nagl fhtagn'},
    {id:'dagon',name:'Dagon, Leviathan',rarity:'Eldritch',weight:250,value:5500,emoji:'🦈',color:'#1a3a4a',qte:'extreme',eldritch:true,lore:'Father of the Deep Ones'},
    {id:'whisperingmaw',name:'Whispering Maw',rarity:'Eldritch',weight:180,value:4500,emoji:'👁️',color:'#4a1a4a',qte:'extreme',eldritch:true,lore:'It speaks in voices of drowned sailors...'},
    {id:'stareater',name:'Star-Eater Angler',rarity:'Eldritch',weight:220,value:4800,emoji:'⭐',color:'#1a1a3a',qte:'extreme',eldritch:true,lore:'Consumes light from distant stars'},
    {id:'voidkraken',name:'Void Kraken Spawn',rarity:'Eldritch',weight:190,value:5200,emoji:'🦑',color:'#0a0a2a',qte:'extreme',eldritch:true,lore:'Born between dimensions'},
    // WORLD BOSS FISH
    {id:'leviathan',name:'Leviathan of the Abyss',rarity:'World Boss',weight:500,value:10000,emoji:'🐉',color:'#ff0000',qte:'boss',boss:true},
    {id:'oceancolossus',name:'Ocean Colossus',rarity:'World Boss',weight:450,value:9000,emoji:'🗿',color:'#8b7355',qte:'boss',boss:true},
    {id:'stormwhaletitan',name:'Storm Whale Titan',rarity:'World Boss',weight:550,value:11000,emoji:'🐋',color:'#4a6fa5',qte:'boss',boss:true,weather:'storm'},
    {id:'voidserpent',name:'Void Serpent',rarity:'World Boss',weight:600,value:12000,emoji:'🐍',color:'#2a0a4a',qte:'boss',boss:true,time:'night'},
    // POSEIDON'S GUARD
    {id:'poseidonguard',name:"Poseidon's Guard",rarity:'Mythical Tale',weight:350,value:15000,emoji:'🔱',color:'#4a90d9',qte:'extreme',requiresPearl:true,lore:'Ancient guardian awakened by the Perfect Pearl'},
  ];

  const mutations = [
    {name:'Alpha',color:'#ff4444',mult:2.0},{name:'Golden',color:'#ffd700',mult:3.0},
    {name:'Radioactive',color:'#00ff00',mult:2.5},{name:'Frostbitten',color:'#00ffff',mult:2.2},
    {name:'Giant',color:'#ff8c00',mult:4.0},{name:'Albino',color:'#ffffff',mult:3.5},
    {name:'Shadow',color:'#333333',mult:2.8},{name:'Predator',color:'#ff0000',mult:5.0},
  ];

  // ============ UI ============
  function updateUI(){
    document.getElementById('playerName').textContent=player.name.substring(0,10);
    document.getElementById('fishCount').textContent=player.fishCaught;
    document.getElementById('goldDisplay').textContent=player.gold;
    document.getElementById('boatStatus').textContent=player.boatOwned?'⛵ Boat':'❌ No Boat';
    document.getElementById('pearlHud').textContent=player.perfectPearl?'💎 Perfect Pearl!':`💎 ${player.pearlShards}/6 Pearls`;
    document.getElementById('eldritchHud').textContent=`👁️ ${player.eldritchCaught}/5 Eldritch`;
    const wEmoji={clear:'☀️',rain:'🌧️',fog:'🌫️',storm:'⛈️',aurora:'🌌',eclipse:'🌑'};
    document.getElementById('weatherHud').textContent=`${wEmoji[weather]||'☀️'} ${weather}`;
    document.getElementById('timeHud').textContent=`🕐 ${Math.floor(dayTime*24)}:00`;
    document.getElementById('eventHud').textContent=bossEvent?'⚡ BOSS EVENT!':weather!=='clear'?`${weather} active`:'Normal';
    
    const craftBtn = document.getElementById('craftPearlBtn');
    if(craftBtn) craftBtn.style.display = (player.pearlShards>=6 && !player.perfectPearl) ? 'inline-block' : 'none';
    document.getElementById('shopPearls').textContent = player.pearlShards;
  }

  // ============ FISHBIO ============
  function openFishBio(){
    const grid=document.getElementById('bioGrid');
    grid.innerHTML='';
    fishDB.forEach(f=>{
      const d=player.discovered.has(f.id);
      const div=document.createElement('div');
      div.style.cssText=`background:#162f3b;padding:6px;border-radius:8px;font-size:0.6rem;border-left:3px solid ${d?f.color:'#555'};opacity:${d?1:0.5}`;
      div.innerHTML=`<strong>${d?f.emoji+' '+f.name:'???'}</strong><br>${f.rarity} · ${f.weight}lbs`;
      grid.appendChild(div);
    });
    document.getElementById('bioCount').textContent=player.discovered.size;
    document.getElementById('fishBioModal').classList.add('active');
  }
  document.getElementById('fishBioBtn').addEventListener('click',openFishBio);

  // ============ JIMMY SHOP ============
  function openShop(){
    document.getElementById('invCount').textContent=player.inventory.length;
    document.getElementById('shopPearls').textContent=player.pearlShards;
    const craftBtn = document.getElementById('craftPearlBtn');
    if(craftBtn) craftBtn.style.display = (player.pearlShards>=6 && !player.perfectPearl) ? 'inline-block' : 'none';
    const jokes=["Nice hat!","I once caught a whale!","Pearl shards whisper...","Ever seen an Eldritch?"];
    document.getElementById('jimmyDialogue').textContent=jokes[Math.floor(Math.random()*jokes.length)];
    document.getElementById('shopModal').classList.add('active');
  }
  document.getElementById('shopBtn').addEventListener('click',openShop);

  function sellAllFish(){
    const total=player.inventory.reduce((s,item)=>s+Math.floor(item.fish.value*(item.mutation?.mult||1)),0);
    player.gold+=total; player.inventory=[];
    updateUI();
    floatingTexts.push({text:`💰 Sold for ${total}!`,x:player.x,y:player.y-20,life:50,color:'#ffd700'});
  }

  function buyBoat(){
    if(!player.boatOwned&&player.gold>=1000){player.boatOwned=true;player.gold-=1000;updateUI();
      floatingTexts.push({text:'🚤 Boat purchased!',x:player.x,y:player.y-20,life:50,color:'#ffd700'});}
    else if(player.boatOwned){floatingTexts.push({text:'Already own a boat!',x:player.x,y:player.y-20,life:40,color:'#ffaa00'});}
    else{floatingTexts.push({text:'Need 1000 coins!',x:player.x,y:player.y-20,life:40,color:'#ff4444'});}
  }

  function craftPearl(){
    if(player.pearlShards>=6 && !player.perfectPearl){
      player.perfectPearl = true; player.pearlShards = 0;
      floatingTexts.push({text:'💎 Perfect Pearl crafted!',x:player.x,y:player.y-20,life:60,color:'#ffd700'});
      updateUI();
    }
  }

  // ============ FISHING ============
  function castLine(tx,ty){
    if(player.waitingForBite||player.fishOnLine||qteActive||player.bossFight)return;
    const zones=player.inOcean?oceanZones:waterZones;
    const spot=zones.find(z=>Math.hypot(tx-z.x,ty-z.y)<z.r);
    if(!spot)return;
    player.isCasting=true; player.castTarget={x:tx,y:ty,spot:spot}; player.castTimer=0;
    floatingTexts.push({text:'🎣 Cast!',x:player.x,y:player.y-15,life:30,color:'#ffffff'});
  }

  function startWaitingForBite(spot){
    player.waitingForBite=true;
    player.biteTimer=40+Math.random()*100;
    player.fishOnLine=selectFish(spot);
  }

  function selectFish(spot){
    let available=fishDB.filter(f=>{
      if(f.boss && !bossEvent) return false;
      if(f.requiresPearl && !player.perfectPearl) return false;
      if(f.weather && weather!==f.weather) return false;
      if(f.time==='night' && dayTime>0.25 && dayTime<0.75) return false;
      if(f.eldritch && !player.inOcean) return false;
      return true;
    });
    if(available.length===0) available=fishDB.filter(f=>!f.boss&&!f.requiresPearl&&!f.eldritch);
    const weights={Common:45,Uncommon:25,Rare:15,Epic:8,Legendary:3,Mythical:1.5,'Tale Fish':0.5,Eldritch:0.3,'World Boss':bossEvent?5:0,'Mythical Tale':player.perfectPearl?0.5:0};
    let total=0;
    const w=available.map(f=>({f,w:weights[f.rarity]||1}));
    total=w.reduce((s,i)=>s+i.w,0);
    let r=Math.random()*total;
    for(let i of w){r-=i.w;if(r<=0)return i.f;}
    return available[0];
  }

  function fishBites(){
    player.waitingForBite=false;
    const fish=player.fishOnLine;
    if(!fish)return;
    floatingTexts.push({text:'❗ BITE!',x:player.castTarget?.x||player.x,y:player.castTarget?.y||player.y-25,life:40,color:'#ff4444'});
    screenShake=8;
    
    if(fish.eldritch) glitchActive = true;
    
    if(fish.qte===false) {
      // Instant catch for common/uncommon
      catchFishSuccess(fish);
    } else {
      // Start QTE with appropriate difficulty
      let greenWidth = 30; // Default medium width
      let markerSpeed = 1.5;
      
      if(fish.qte==='easy') { greenWidth = 45; markerSpeed = 1.0; }
      else if(fish.qte==='medium') { greenWidth = 30; markerSpeed = 1.5; }
      else if(fish.qte==='hard') { greenWidth = 20; markerSpeed = 2.2; }
      else if(fish.qte==='extreme') { greenWidth = 12; markerSpeed = 3.0; }
      else if(fish.qte==='boss') { greenWidth = 15; markerSpeed = 2.8; }
      
      startQTE(fish, greenWidth, markerSpeed);
    }
  }

  function startQTE(fish, greenWidth, markerSpeed){
    qteActive = true;
    qteFish = fish;
    qteProgress = 50;
    qteMarkerPos = 20 + Math.random() * 60; // Random starting position
    qteMarkerDirection = Math.random() > 0.5 ? 1 : -1;
    qteMarkerSpeed = markerSpeed;
    
    // Set green zone
    qteGreenStart = 50 - greenWidth/2;
    qteGreenEnd = 50 + greenWidth/2;
    
    // Update UI
    document.getElementById('qteTargetZone').style.left = qteGreenStart + '%';
    document.getElementById('qteTargetZone').style.width = greenWidth + '%';
    document.getElementById('qteBarContainer').classList.add('active');
    
    updateQTEDisplay();
  }

  function updateQTE(){
    if(!qteActive) return;
    
    // Move marker
    qteMarkerPos += qteMarkerSpeed * qteMarkerDirection;
    
    // Bounce off edges
    if(qteMarkerPos >= 95) qteMarkerDirection = -1;
    if(qteMarkerPos <= 5) qteMarkerDirection = 1;
    
    // Slowly decrease progress (tension)
    qteProgress -= 0.15;
    if(qteProgress <= 0) {
      failQTE();
      return;
    }
    
    updateQTEDisplay();
  }

  function updateQTEDisplay(){
    document.getElementById('qteMarker').style.left = qteMarkerPos + '%';
    document.getElementById('qteBarFill').style.width = qteProgress + '%';
  }

  function hookFish(){
    if(!qteActive) return;
    
    // Check if marker is in green zone
    if(qteMarkerPos >= qteGreenStart && qteMarkerPos <= qteGreenEnd) {
      // Success! Add progress
      qteProgress += 15;
      
      // Visual feedback
      floatingTexts.push({text:'✓',x:player.x,y:player.y-30,life:20,color:'#4caf92'});
      
      if(player.bossFight) {
        player.bossFight.health -= 15;
        document.getElementById('bossFill').style.width = player.bossFight.health + '%';
        if(player.bossFight.health <= 0) {
          qteActive = false;
          player.bossFight = null;
          document.getElementById('bossBar').classList.remove('active');
          document.getElementById('qteBarContainer').classList.remove('active');
          catchFishSuccess(qteFish);
          return;
        }
      }
      
      if(qteProgress >= 100) {
        // Caught the fish!
        qteActive = false;
        document.getElementById('qteBarContainer').classList.remove('active');
        if(player.bossFight) {
          document.getElementById('bossBar').classList.remove('active');
          player.bossFight = null;
        }
        catchFishSuccess(qteFish);
      }
    } else {
      // Miss! Lose progress
      qteProgress -= 10;
      floatingTexts.push({text:'✗',x:player.x,y:player.y-30,life:20,color:'#ff4444'});
      if(qteProgress <= 0) {
        failQTE();
      }
    }
    
    updateQTEDisplay();
  }

  function failQTE(){
    qteActive = false;
    if(player.bossFight) {
      document.getElementById('bossBar').classList.remove('active');
      player.bossFight = null;
    }
    document.getElementById('qteBarContainer').classList.remove('active');
    floatingTexts.push({text:'💨 Escaped!',x:player.x,y:player.y,life:40,color:'#ff4444'});
    glitchActive = false;
    player.fishOnLine = null;
  }

  function catchFishSuccess(fish){
    const weight=(fish.weight*(0.7+Math.random()*0.6)).toFixed(1);
    let mutation=null;
    if(Math.random()<0.1)mutation=mutations[Math.floor(Math.random()*mutations.length)];
    
    player.fishCaught++;
    player.gold+=Math.floor(fish.value*(mutation?.mult||1));
    player.discovered.add(fish.id);
    
    if(fish.eldritch){
      player.eldritchCaught++;
      if(player.eldritchCaught>=5 && !player.lovecraftedAchievement){
        player.lovecraftedAchievement=true;
        floatingTexts.push({text:'🏆 H.P. LOVECRAFTED!',x:player.x,y:player.y-30,life:100,color:'#ffd700'});
      }
    }
    
    if(fish.id==='poseidonguard') player.perfectPearl=false;
    
    if(!player.mutationRecords[fish.id])player.mutationRecords[fish.id]=[];
    if(mutation&&!player.mutationRecords[fish.id].includes(mutation.name))player.mutationRecords[fish.id].push(mutation.name);
    if(!player.bestWeights[fish.id]||parseFloat(weight)>parseFloat(player.bestWeights[fish.id]))player.bestWeights[fish.id]=weight;
    
    if(player.inOcean && Math.random()<0.01 && player.pearlShards<6 && !player.perfectPearl){
      player.pearlShards++;
      floatingTexts.push({text:'💎 Pearl Shard!',x:player.x,y:player.y-20,life:60,color:'#ffd700'});
    }
    
    player.inventory.push({fish,weight,mutation});
    showCatchCard(fish,weight,mutation);
    spawnParticles(player.x,player.y,25,fish.color);
    if(fish.rarity==='Eldritch'||fish.rarity==='World Boss')screenShake=25;
    
    player.fishOnLine=null;
    glitchActive=false;
    updateUI();
  }

  function showCatchCard(fish,weight,mutation){
    const card=document.getElementById('catchCard');
    document.getElementById('catchEmoji').textContent=fish.emoji;
    document.getElementById('catchName').textContent=fish.name;
    document.getElementById('catchRarity').textContent=fish.rarity;
    document.getElementById('catchRarity').style.color=fish.color;
    document.getElementById('catchWeight').textContent=`${weight} lbs`;
    document.getElementById('catchMutation').textContent=mutation?`🧬 ${mutation.name}`:'';
    document.getElementById('catchValue').textContent=`💰 ${Math.floor(fish.value*(mutation?.mult||1))}`;
    card.classList.add('show');
    setTimeout(()=>card.classList.remove('show'),2500);
  }

  function spawnParticles(x,y,count,color){
    for(let i=0;i<count;i++)particles.push({x,y,vx:(Math.random()-0.5)*4,vy:(Math.random()-0.5)*4-3,life:1,color,size:2+Math.random()*4});
  }

  // ============ BOSS EVENTS ============
  function triggerBossEvent(){
    if(bossEvent||!player.inOcean)return;
    if(Math.random()<0.001){
      const bosses=fishDB.filter(f=>f.boss&&(!f.weather||f.weather===weather));
      if(bosses.length>0){
        bossEvent=bosses[Math.floor(Math.random()*bosses.length)];
        weather='storm';
        floatingTexts.push({text:`⚡ ${bossEvent.name} SPAWNS!`,x:450,y:280,life:120,color:'#ff0000'});
        setTimeout(()=>{bossEvent=null;if(weather==='storm')weather='clear';},45000);
      }
    }
  }

  // ============ OCEAN ============
  function generateOcean(){
    oceanZones=[];
    for(let i=0;i<20;i++)oceanZones.push({x:100+Math.random()*700,y:50+Math.random()*450,r:30+Math.random()*30,type:'ocean'});
  }

  // ============ MULTIPLAYER ============
  function syncPlayers(){
    const data=JSON.parse(localStorage.getItem('mythic_room_'+document.getElementById('roomInput').value)||'{}');
    data[player.name]={x:player.x,y:player.y,name:player.name,time:Date.now()};
    localStorage.setItem('mythic_room_'+document.getElementById('roomInput').value,JSON.stringify(data));
    multiplayerPlayers=Object.values(data).filter(p=>p.name!==player.name&&Date.now()-p.time<12000);
  }

  document.getElementById('joinBtn').addEventListener('click',()=>{
    document.getElementById('roomInput').value=document.getElementById('roomInput').value||'abyss';
    syncPlayers();
  });

  // ============ RENDER ============
  function draw(){
    ctx.clearRect(0,0,900,560);
    let sx=0,sy=0;
    if(screenShake>0){sx=(Math.random()-0.5)*screenShake;sy=(Math.random()-0.5)*screenShake;screenShake*=0.9;if(screenShake<0.1)screenShake=0;}
    ctx.save();ctx.translate(sx,sy);
    
    const night=Math.sin(dayTime*Math.PI);
    ctx.fillStyle=`rgb(${10+night*20},${15+night*30},${30+night*50})`;
    ctx.fillRect(0,0,900,560);
    
    if(bossEvent)ctx.fillStyle='rgba(255,0,0,0.1)';
    ctx.fillRect(0,0,900,560);
    
    ctx.fillStyle='#2a402a';ctx.fillRect(0,310,900,250);
    
    const zones=player.inOcean?oceanZones:waterZones;
    zones.forEach(z=>{
      const g=ctx.createRadialGradient(z.x,z.y,z.r*0.2,z.x,z.y,z.r);
      g.addColorStop(0,'rgba(20,80,160,0.9)');g.addColorStop(1,'rgba(8,40,90,0.7)');
      ctx.fillStyle=g;ctx.beginPath();ctx.arc(z.x,z.y,z.r,0,Math.PI*2);ctx.fill();
    });
    
    ctx.fillStyle='#f5e56c';ctx.beginPath();ctx.arc(jimmy.x,jimmy.y,14,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='black';ctx.font='bold 9px monospace';ctx.fillText('🐟 Jimmy',jimmy.x-30,jimmy.y-18);
    
    multiplayerPlayers.forEach(p=>{
      ctx.fillStyle='#ffb347';ctx.beginPath();ctx.arc(p.x,p.y,10,0,Math.PI*2);ctx.fill();
    });
    
    const bob=Math.sin(Date.now()*0.005)*2;
    ctx.fillStyle='#34c9eb';ctx.beginPath();ctx.arc(player.x,player.y+bob,12,0,Math.PI*2);ctx.fill();
    
    if(player.isCasting){
      player.castTimer++;
      const progress=Math.min(1,player.castTimer/25);
      if(player.castTarget){
        const cx=player.x+(player.castTarget.x-player.x)*progress;
        const cy=player.y+(player.castTarget.y-player.y)*progress-Math.sin(progress*Math.PI)*35;
        ctx.fillStyle='#ff6666';ctx.beginPath();ctx.arc(cx,cy,4,0,Math.PI*2);ctx.fill();
        if(progress>=1){player.isCasting=false;startWaitingForBite(player.castTarget.spot);}
      }
    }
    
    if(player.waitingForBite&&player.castTarget){
      const by=player.castTarget.y+Math.sin(Date.now()*0.015)*6;
      ctx.fillStyle='#ff4444';ctx.beginPath();ctx.arc(player.castTarget.x,by,6,0,Math.PI*2);ctx.fill();
      if(player.biteTimer<35)ctx.fillText('❗',player.castTarget.x-10,by-18);
    }
    
    floatingTexts=floatingTexts.filter(t=>{t.life--;return t.life>0;});
    floatingTexts.forEach(t=>{
      ctx.fillStyle=t.color;ctx.font='bold 13px sans-serif';
      ctx.fillText(t.text,t.x-40,t.y-(60-t.life)*0.5);
    });
    
    particles=particles.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.life-=0.015;return p.life>0;});
    particles.forEach(p=>{ctx.fillStyle=p.color;ctx.globalAlpha=p.life;ctx.fillRect(p.x,p.y,p.size,p.size);});
    ctx.globalAlpha=1;
    
    ctx.restore();
  }

  // ============ GAME LOOP ============
  function update(){
    dayTime+=0.00025;if(dayTime>1)dayTime=0;
    weatherTimer++;if(weatherTimer>450){weather=['clear','rain','fog','storm','aurora'][Math.floor(Math.random()*5)];weatherTimer=0;}
    if(player.waitingForBite){player.biteTimer--;if(player.biteTimer<=0)fishBites();}
    updateQTE();
    triggerBossEvent();
    updateUI();
  }

  function gameLoop(){update();draw();requestAnimationFrame(gameLoop);}

  // ============ CONTROLS ============
  const keys={};
  canvas.addEventListener('click',e=>{
    const rect=canvas.getBoundingClientRect();
    const mx=(e.clientX-rect.left)*(900/rect.width);
    const my=(e.clientY-rect.top)*(560/rect.height);
    
    if(Math.hypot(mx-jimmy.x,my-jimmy.y)<30){openShop();return;}
    if(!qteActive&&!player.waitingForBite&&!player.fishOnLine&&!player.bossFight)castLine(mx,my);
  });

  window.addEventListener('keydown',e=>{
    keys[e.code]=true;
    if(e.code==='Space'){
      e.preventDefault();
      if(qteActive){
        hookFish();
      } else if(player.boatOwned&&!player.waitingForBite&&!player.isCasting){
        player.inOcean=!player.inOcean;
        if(player.inOcean&&oceanZones.length===0)generateOcean();
        floatingTexts.push({text:player.inOcean?'🌊 Sailing ocean!':'🏝️ Returned to island',x:player.x,y:player.y-20,life:40,color:'#7fc9ff'});
      }
    }
  });
  window.addEventListener('keyup',e=>{keys[e.code]=false;});

  setInterval(()=>{
    if(qteActive)return;
    let dx=0,dy=0;
    if(keys['KeyW']||keys['ArrowUp'])dy--;
    if(keys['KeyS']||keys['ArrowDown'])dy++;
    if(keys['KeyA']||keys['ArrowLeft'])dx--;
    if(keys['KeyD']||keys['ArrowRight'])dx++;
    if(dx||dy){
      const len=Math.sqrt(dx*dx+dy*dy);
      player.x=Math.min(880,Math.max(20,player.x+dx/len*player.speed));
      player.y=Math.min(540,Math.max(20,player.y+dy/len*player.speed));
    }
  },16);

  setInterval(syncPlayers,2500);

  updateUI();
  gameLoop();
})();
</script>
</body>
</html>
