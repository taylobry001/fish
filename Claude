// ─── UPGRADE HELPERS ─────────────────────────────────────
function getUpgradeLevel(id) { return G.player.upgrades[id] || 0; }
function upgradeCost(id) {
  const def = ROD_UPGRADES.find(r=>r.id===id);
  if(!def) return 9999;
  const lv = getUpgradeLevel(id);
  return Math.floor(def.baseCost * Math.pow(1.6, lv));
}
function getReelZoneWidth() { return 25 + getUpgradeLevel('rod_strength') * 5; }
function getReelCursorSpeed() { return Math.max(0.3, 1.8 - getUpgradeLevel('rod_speed') * 0.1); }
function getSanityResist() { return 1 - getUpgradeLevel('rod_sanity') * 0.08; }
function getLuckBonus() { return 1 + getUpgradeLevel('rod_luck') * 0.05; }
function getXpMult() { return 1 + getUpgradeLevel('rod_xp') * 0.2; }
 
// ─── BOIDS ───────────────────────────────────────────────
function initBoids(n=30) {
  G.boids = [];
  for(let i=0;i<n;i++) {
    G.boids.push({
      x: Math.random()*W, y: H*0.3 + Math.random()*H*0.5,
      vx: (Math.random()-0.5)*1.5, vy: (Math.random()-0.5)*0.8,
      id: FISH[Math.floor(Math.random()*8)].id,
      size: 4+Math.random()*6, angle:0, wobble:Math.random()*Math.PI*2
    });
  }
}
 
function updateBoids() {
  const sep=25,ali=80,coh=100,maxSpeed=2,avoidR=120;
  const lure = G.bobber;
  for(const b of G.boids) {
    let sx=0,sy=0,ax=0,ay=0,cx=0,cy=0,cn=0;
    for(const o of G.boids) {
      if(o===b) continue;
      const dx=b.x-o.x,dy=b.y-o.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<sep&&d>0){sx+=dx/d;sy+=dy/d;}
      if(d<ali){ax+=o.vx;ay+=o.vy;cn++;}
      if(d<coh){cx+=o.x;cy+=o.y;}
    }
    if(cn>0){ax/=cn;ay/=cn;cx=cx/cn-b.x;cy=cy/cn-b.y;}
    // Lure attraction
    if(lure){
      const dx=lure.x-b.x,dy=lure.y-b.y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<avoidR){ax+=dx/d*0.5;ay+=dy/d*0.5;}
    }
    b.vx += sx*0.03 + ax*0.02 + cx*0.01;
    b.vy += sy*0.03 + ay*0.02 + cy*0.01;
    const speed=Math.sqrt(b.vx*b.vx+b.vy*b.vy);
    if(speed>maxSpeed){b.vx=b.vx/speed*maxSpeed;b.vy=b.vy/speed*maxSpeed;}
    b.x+=b.vx; b.y+=b.vy;
    b.wobble+=0.12;
    b.angle=Math.atan2(b.vy,b.vx);
    if(b.x<-20) b.x=W+20;
    if(b.x>W+20) b.x=-20;
    b.y=Math.max(H*0.22,Math.min(H*0.88,b.y));
  }
}
 
