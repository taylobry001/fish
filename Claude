<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=IM+Fell+English:ital@0;1&family=Share+Tech+Mono&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
:root{
  --abyss:#020408;--deep:#040d14;--mid:#071624;--surface:#0a2030;
  --eldritch:#6b21a8;--void:#1a0530;--tentacle:#4a0e6e;
  --gold:#c9953a;--goldhi:#f4d57e;--silver:#a8c4d0;
  --danger:#c0392b;--success:#1a7a4a;--horror:#7c1d1d;
  --text:#c8e8f0;--textdim:#5a8090;--white:#e8f4f8;
  --glow1:rgba(107,33,168,0.6);--glow2:rgba(201,149,58,0.5);
  --font-display:'Cinzel Decorative',serif;
  --font-body:'IM Fell English',serif;
  --font-mono:'Share Tech Mono',monospace;
}
html,body{width:100%;height:100%;overflow:hidden;background:var(--abyss);}
body{font-family:var(--font-body);color:var(--text);cursor:crosshair;touch-action:none;}
#canvas{display:block;width:100vw;height:100vh;image-rendering:crisp-edges;}
#hud{
  position:fixed;top:0;left:0;right:0;
  display:flex;justify-content:space-between;align-items:flex-start;
  padding:8px 12px;pointer-events:none;z-index:50;
  background:linear-gradient(to bottom,rgba(2,4,8,0.95),transparent);
}
.hud-left,.hud-right,.hud-center{display:flex;flex-direction:column;gap:4px;}
.hud-center{align-items:center;}
.stat{
  font-family:var(--font-mono);font-size:11px;color:var(--text);
  background:rgba(2,4,8,0.7);border:1px solid rgba(201,149,58,0.3);
  padding:3px 8px;border-radius:3px;white-space:nowrap;
}
.stat-bar{width:120px;height:8px;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.1);border-radius:4px;overflow:hidden;margin-top:2px;}
.stat-fill{height:100%;transition:width 0.3s;border-radius:4px;}
#sanityBar .stat-fill{background:linear-gradient(90deg,#7c1d1d,#6b21a8);}
#xpBar .stat-fill{background:linear-gradient(90deg,#c9953a,#f4d57e);}
#sanityLabel{font-size:9px;color:var(--textdim);}
.title-hud{font-family:var(--font-display);font-size:14px;color:var(--goldhi);text-shadow:0 0 12px var(--gold),0 0 24px rgba(107,33,168,0.8);letter-spacing:1px;}
#btm-bar{
  position:fixed;bottom:0;left:0;right:0;
  display:flex;justify-content:space-around;align-items:center;
  padding:8px 6px calc(8px + env(safe-area-inset-bottom));
  background:linear-gradient(to top,rgba(2,4,8,0.98),rgba(2,4,8,0.8));
  border-top:1px solid rgba(201,149,58,0.3);z-index:50;gap:4px;flex-wrap:wrap;
}
.btn{
  font-family:var(--font-mono);font-size:10px;color:var(--goldhi);
  background:rgba(10,20,30,0.9);border:1px solid rgba(201,149,58,0.5);
  padding:6px 10px;border-radius:6px;cursor:pointer;
  box-shadow:0 2px 8px rgba(0,0,0,0.5),inset 0 1px 0 rgba(244,213,126,0.1);
  transition:all 0.15s;user-select:none;touch-action:manipulation;
  text-shadow:0 0 8px var(--gold);white-space:nowrap;
}
.btn:active,.btn:hover{background:rgba(20,40,55,0.95);border-color:var(--gold);transform:translateY(-1px);box-shadow:0 4px 12px rgba(201,149,58,0.3);}
.btn.danger{border-color:rgba(192,57,43,0.6);color:#f07060;text-shadow:0 0 8px #c0392b;}
.modal-overlay{
  position:fixed;inset:0;background:rgba(2,4,8,0.85);z-index:100;
  display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(4px);display:none;
}
.modal-overlay.open{display:flex;animation:fadeIn 0.2s;}
.modal{
  background:linear-gradient(160deg,#0a1828,#04080f);
  border:1px solid var(--gold);border-radius:12px;
  padding:20px;max-width:520px;width:92%;
  max-height:80vh;overflow-y:auto;
  box-shadow:0 0 40px rgba(201,149,58,0.2),0 0 80px rgba(107,33,168,0.1);
  font-family:var(--font-body);color:var(--text);
}
.modal h2{font-family:var(--font-display);color:var(--goldhi);font-size:16px;margin-bottom:12px;text-shadow:0 0 12px var(--gold);}
.modal h3{font-family:var(--font-display);color:var(--silver);font-size:13px;margin:10px 0 6px;}
.modal-close{float:right;cursor:pointer;color:var(--textdim);font-size:18px;line-height:1;}
.modal-close:hover{color:var(--gold);}
.quest-item{
  background:rgba(7,22,36,0.8);border:1px solid rgba(107,33,168,0.4);
  border-radius:8px;padding:10px;margin-bottom:8px;
}
.quest-item.active{border-color:rgba(201,149,58,0.5);}
.quest-item.complete{border-color:rgba(26,122,74,0.6);opacity:0.7;}
.quest-title{font-family:var(--font-mono);font-size:11px;color:var(--goldhi);}
.quest-desc{font-size:11px;color:var(--textdim);margin:4px 0;}
.progress-bar{height:6px;background:rgba(0,0,0,0.4);border-radius:3px;margin:4px 0;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--eldritch),var(--gold));border-radius:3px;transition:width 0.4s;}
.fish-card{
  display:flex;align-items:center;gap:8px;
  background:rgba(4,8,15,0.8);border:1px solid rgba(255,255,255,0.08);
  border-radius:6px;padding:6px 8px;margin:3px 0;font-size:10px;
  font-family:var(--font-mono);
}
.fish-card.undiscovered{opacity:0.35;filter:grayscale(1);}
.rarity-common{color:#8a9ba8;}
.rarity-uncommon{color:#4CAF50;}
.rarity-rare{color:#2196F3;}
.rarity-epic{color:var(--eldritch);}
.rarity-legendary{color:var(--gold);}
.rarity-eldritch{color:#e040fb;text-shadow:0 0 8px #e040fb;}
.rarity-mythical{color:var(--goldhi);text-shadow:0 0 12px var(--gold),0 0 24px rgba(107,33,168,0.8);}
#reel-overlay{
  position:fixed;bottom:80px;left:50%;transform:translateX(-50%);
  width:min(340px,88vw);z-index:80;display:none;
  background:rgba(2,4,8,0.95);border:1px solid var(--gold);
  border-radius:12px;padding:14px 16px;
  box-shadow:0 0 30px rgba(201,149,58,0.3);
}
#reel-overlay.active{display:block;animation:slideUp 0.2s;}
#reel-track{height:36px;background:rgba(0,0,0,0.5);border-radius:18px;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,0.1);}
#reel-zone{position:absolute;top:0;height:100%;background:rgba(26,122,74,0.4);border-left:2px solid #2ecc71;border-right:2px solid #2ecc71;transition:left 0.1s,width 0.1s;}
#reel-cursor{
  position:absolute;top:50%;transform:translateY(-50%);
  width:10px;height:28px;background:var(--gold);border-radius:5px;
  box-shadow:0 0 16px var(--gold),0 0 32px rgba(201,149,58,0.5);
  transition:left 0.04s;
}
#reel-label{font-family:var(--font-mono);font-size:10px;color:var(--textdim);text-align:center;margin-top:6px;}
#reel-tension{height:6px;background:rgba(0,0,0,0.4);border-radius:3px;margin-top:6px;}
#reel-tension-fill{height:100%;background:linear-gradient(90deg,#2ecc71,#e74c3c);border-radius:3px;transition:width 0.1s;}
#cast-meter{
  position:fixed;bottom:80px;right:16px;
  width:36px;height:140px;
  background:rgba(2,4,8,0.9);border:1px solid rgba(201,149,58,0.4);
  border-radius:18px;display:none;overflow:hidden;
  box-shadow:0 0 16px rgba(201,149,58,0.2);z-index:80;
}
#cast-meter.active{display:block;}
#cast-meter-fill{
  position:absolute;bottom:0;width:100%;
  background:linear-gradient(to top,var(--gold),#e040fb);
  transition:height 0.05s;border-radius:0 0 18px 18px;
}
#cast-meter-zone{
  position:absolute;left:0;right:0;
  background:rgba(46,204,113,0.35);border-top:2px solid #2ecc71;border-bottom:2px solid #2ecc71;
}
#catch-popup{
  position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0);
  background:linear-gradient(160deg,#0a1828,#04080f);
  border:2px solid var(--gold);border-radius:16px;
  padding:22px;text-align:center;z-index:200;
  box-shadow:0 0 60px rgba(201,149,58,0.4),0 0 120px rgba(107,33,168,0.2);
  min-width:260px;transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
  font-family:var(--font-body);
}
#catch-popup.show{transform:translate(-50%,-50%) scale(1);}
#catch-emoji{font-size:48px;display:block;margin-bottom:8px;}
#catch-name{font-family:var(--font-display);font-size:16px;color:var(--goldhi);}
#catch-rarity-text{font-size:12px;margin:4px 0;}
#catch-stats{font-family:var(--font-mono);font-size:10px;color:var(--textdim);margin-top:8px;}
#layer-indicator{
  position:fixed;top:50%;left:8px;transform:translateY(-50%);
  font-family:var(--font-mono);font-size:9px;color:var(--textdim);
  writing-mode:vertical-rl;text-orientation:mixed;
  background:rgba(2,4,8,0.7);padding:8px 4px;border-radius:4px;
  border:1px solid rgba(107,33,168,0.3);pointer-events:none;z-index:50;
}
#event-banner{
  position:fixed;top:60px;left:50%;transform:translateX(-50%);
  font-family:var(--font-display);font-size:12px;color:var(--gold);
  background:rgba(2,4,8,0.9);border:1px solid rgba(201,149,58,0.5);
  padding:6px 16px;border-radius:20px;pointer-events:none;z-index:60;
  opacity:0;transition:opacity 0.4s;white-space:nowrap;
  text-shadow:0 0 12px var(--gold);
}
#event-banner.show{opacity:1;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
@keyframes slideUp{from{transform:translateX(-50%) translateY(20px);opacity:0;}to{transform:translateX(-50%) translateY(0);opacity:1;}}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.5;}}
@keyframes tentacleWave{0%{transform:scaleX(1);}50%{transform:scaleX(1.05);}100%{transform:scaleX(1);}}
.shimmer{animation:pulse 2s infinite;}
</style>
</head>
