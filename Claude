// ─── WEATHER ─────────────────────────────────────────────
const WEATHERS = ['calm','calm','calm','rain','fog','storm','aurora','storm'];
function tickWeather() {
  G.weatherTimer++;
  if(G.weatherTimer > 600+Math.random()*600) {
    G.weather = WEATHERS[Math.floor(Math.random()*WEATHERS.length)];
    G.weatherTimer=0;
    G.time = G.time; // keep time
  }
}
 
// ─── FISH SELECTION ──────────────────────────────────────
function selectFish() {
  const bait = G.player.activeBait;
  const layer = G.player.layer;
  const night = G.time > 0.5;
  const storm = G.weather === 'storm';
  const fog = G.weather === 'fog';
  const aurora = G.weather === 'aurora';
 
  // Check if a mythical is ready from quest
  if(G.questMythicalReady) {
    const f = FISH.find(f=>f.id===G.questMythicalReady);
    if(f) { G.questMythicalReady=null; return f; }
  }
 
  let pool = FISH.filter(f => {
    if(f.mythical) return false; // only via quest
    if(f.layer > layer) return false;
    return true;
  });
 
  const weights = pool.map(f => {
    let w = {
      common: 100, uncommon:40, rare:15, epic:5, eldritch:2
    }[f.rarity] || 2;
 
    // Bait modifiers
    if(bait==='glowbait' && f.eldritch) w *= 3;
    if(bait==='abyssal_lure' && f.rarity==='eldritch') w *= 2;
    if(bait==='slimebait' && f.id==='shoggoth') w *= 8;
    if(bait==='deep_bait' && f.layer>=3) w *= 2.5;
    if(bait==='prism_bait' && f.id==='colourspace') w *= 8;
 
    // Weather modifiers
    if(storm && f.eldritch) w *= 2.5;
    if(aurora && f.rarity==='epic') w *= 2;
    if(fog && f.rarity==='rare') w *= 1.8;
    if(night && ['anglerfish','viperfish','goblinshark','nightgaunt'].includes(f.id)) w *= 3;
 
    // Layer bonus
    if(f.layer === layer) w *= 1.5;
 
    // Luck
    w *= getLuckBonus();
 
    return { f, w };
  });
 
  let total = weights.reduce((s,i)=>s+i.w,0);
  let r = Math.random()*total;
  for(const {f,w} of weights) {
    r-=w; if(r<=0) return f;
  }
  return pool[0];
}
 
// ─── REEL ────────────────────────────────────────────────
function startReel(fish) {
  G.state = 'reeling';
  const speed = getReelCursorSpeed();
  const zoneW = getReelZoneWidth();
  let difficulty = {simple:1,easy:1.2,medium:1.5,hard:2.0,boss:2.8}[fish.qte]||1;
  if(fish.rarity==='eldritch'||fish.rarity==='mythical') difficulty*=1.3;
  G.reel = {
    fish,
    cursor:15, dir:1,
    speed: speed * difficulty,
    zoneStart: 30,
    zoneEnd: 30+zoneW,
    progress:50,
    tension:50,
    phase:0, // 0=normal, 1=tentacle dodge, 2=sanity wave
    phaseTimer:0,
    maxProgress:100,
    failed:false
  };
  const zoneEl = document.getElementById('reel-zone');
  zoneEl.style.left = G.reel.zoneStart+'%';
  zoneEl.style.width = (G.reel.zoneEnd-G.reel.zoneStart)+'%';
  document.getElementById('reel-fish-name').textContent = fish.name;
  document.getElementById('reel-overlay').classList.add('active');
  G.glitch = fish.eldritch || fish.mythical;
}
 
function tickReel() {
  if(!G.reel) return;
  const r = G.reel;
  r.cursor += r.speed * r.dir;
  if(r.cursor>=95){r.dir=-1;}
  if(r.cursor<=5){r.dir=1;}
  r.progress -= 0.12;
  r.tension += (Math.random()-0.48)*0.5;
  r.tension = Math.max(10,Math.min(90,r.tension));
  r.phaseTimer++;
  if((r.fish.qte==='boss'||r.fish.rarity==='eldritch') && r.phaseTimer>180) {
    r.phase = (r.phase+1)%3;
    r.phaseTimer=0;
    if(r.phase===1) {
      r.zoneStart = 10+Math.random()*40;
      r.zoneEnd = r.zoneStart + getReelZoneWidth()*0.7;
      floatText(W/2,H/2,'⚠️ DODGE!','#e74c3c',16);
      document.getElementById('reel-zone').style.left=r.zoneStart+'%';
      document.getElementById('reel-zone').style.width=(r.zoneEnd-r.zoneStart)+'%';
    } else if(r.phase===2) {
      drainSanity(5*getSanityResist());
      floatText(W/2,H/2-20,'🧠 SANITY WAVE','#e040fb',14);
    }
  }
  if(r.progress<=0) { reelFail(); return; }
  document.getElementById('reel-cursor').style.left=r.cursor+'%';
  document.getElementById('reel-tension-fill').style.width=r.tension+'%';
  document.getElementById('reel-overlay').querySelector('#reel-tension-fill').style.background =
    r.tension>70 ? 'linear-gradient(90deg,#e74c3c,#c0392b)' : 'linear-gradient(90deg,#2ecc71,#e74c3c)';
}
 
function reelHook() {
  if(!G.reel) return;
  const r=G.reel;
  const inZone = r.cursor>=r.zoneStart && r.cursor<=r.zoneEnd;
  if(inZone) {
    r.progress=Math.min(r.maxProgress,r.progress+18);
    spawnParticles(W/2,H*0.5,8,'#2ecc71','splash');
    floatText(W/2,H*0.45,'✓',  '#2ecc71',18);
    if(r.progress>=r.maxProgress) reelSuccess();
  } else {
    r.progress-=12;
    G.screenShake=6;
    floatText(W/2,H*0.45,'✗','#e74c3c',18);
    if(r.progress<=0) reelFail();
  }
  document.getElementById('reel-overlay').querySelector('#reel-tension-fill').style.width=r.tension+'%';
}
 
function reelSuccess() {
  const fish = G.reel.fish;
  document.getElementById('reel-overlay').classList.remove('active');
  G.reel=null; G.state='caught'; G.glitch=false;
  catchFish(fish);
  if(fish.qte==='boss'||fish.rarity==='eldritch'||fish.rarity==='mythical') {
    G.player.bossReelsWon++;
    updateQuestProgress('boss_reel',1);
  }
}
 
function reelFail() {
  document.getElementById('reel-overlay').classList.remove('active');
  G.reel=null; G.state='idle'; G.fishOnLine=null; G.bobber=null; G.glitch=false;
  floatText(W/2,H*0.4,'💨 Escaped!','#e74c3c',16);
  G.screenShake=10;
  drainSanity(3);
}
 
// ─── SANITY ──────────────────────────────────────────────
function drainSanity(amount) {
  const actual = amount * getSanityResist();
  G.player.sanity = Math.max(0, G.player.sanity - actual);
  G.player.sanityLostTotal += actual;
  updateQuestProgress('sanity_lost', actual);
  if(G.player.sanity <= 0) {
    updateQuestProgress('zero_sanity', 1);
    showEventBanner('🧠 SANITY SHATTERED — The Void Speaks');
    G.player.sanity=5; // survive, barely
  }
}
 
function regenSanity(amount) {
  G.player.sanity = Math.min(G.player.maxSanity, G.player.sanity+amount);
}
 
// ─── CATCH ───────────────────────────────────────────────
function catchFish(fish) {
  const w1 = fish.weight[0], w2 = fish.weight[1];
  const weight = w1===0&&w2===0 ? 0 : +(w1 + Math.random()*(w2-w1)).toFixed(1);
  const xpGain = Math.floor(fish.xp * getXpMult());
 
  G.player.catches++;
  G.player.coins += fish.value;
  G.player.xp += xpGain;
  G.player.inventory.push({fish:fish.id, weight, value:fish.value, caught:Date.now()});
  G.player.discoveredFish.add(fish.id);
 
  if(fish.sanityDrain) drainSanity(fish.sanityDrain);
  else regenSanity(2);
 
  // Level up
  while(G.player.xp >= G.player.xpThreshold) {
    G.player.xp -= G.player.xpThreshold;
    G.player.level++;
    G.player.xpThreshold = Math.floor(G.player.xpThreshold * 1.5);
    floatText(W/2, H/3, `✨ LEVEL ${G.player.level}!`, '#f4d57e', 20);
    showEventBanner(`⬆️ Level ${G.player.level}!`);
    // Unlock layers with levels
    if(G.player.level>=5 && G.player.layer<2) unlockLayer(2);
    if(G.player.level>=15 && G.player.layer<3) unlockLayer(3);
    if(G.player.level>=30 && G.player.layer<4) unlockLayer(4);
    if(G.player.level>=50 && G.player.layer<5) unlockLayer(5);
  }
 
  updateQuestProgress('catch', fish.id, 1);
  updateQuestProgress('catch_rarity', fish.rarity, 1);
  if(fish.eldritch) updateQuestProgress('catch_eldritch', null, 1);
  if(fish.mythical) updateQuestProgress('catch_mythical', fish.id, 1);
  updateQuestProgress('total_catches', null, 1);
 
  // Show catch popup
  showCatchPopup(fish, weight, xpGain);
  spawnParticles(W/2, H*0.4, 20, fish.eldritch ? '#e040fb' : '#2ecc71', fish.eldritch ? 'gore' : 'splash');
  if(fish.rarity==='mythical') {
    spawnParticles(W/2,H/2,60,'#f4d57e','splash');
    G.screenShake=20;
    showEventBanner(`🏆 MYTHICAL CAUGHT: ${fish.name}!`);
  }
 
  G.bobber = null; G.fishOnLine = null;
  setTimeout(()=>{ G.state='idle'; }, 500);
 
  updateHUD();
  maybeAutoSave();
}
 
function unlockLayer(n) {
  G.player.layer = Math.max(G.player.layer, n);
  floatText(W/2, H/2, `🌊 LAYER ${n} UNLOCKED`, '#e040fb', 18);
  showEventBanner(`🌊 Abyssal Layer ${n} Unlocked — Deeper Terrors Await`);
}
 
function showCatchPopup(fish, weight, xp) {
  document.getElementById('catch-emoji').textContent = fish.emoji;
  document.getElementById('catch-name').textContent = fish.name;
  const rarityColors = {common:'#8a9ba8',uncommon:'#4CAF50',rare:'#2196F3',epic:'#9c27b0',eldritch:'#e040fb',mythical:'#f4d57e',legendary:'#c9953a'};
  const rc = rarityColors[fish.rarity]||'#fff';
  document.getElementById('catch-rarity-text').textContent = fish.rarity.toUpperCase();
  document.getElementById('catch-rarity-text').style.color = rc;
