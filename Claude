// ─── DRAW ─────────────────────────────────────────────────
function getLayerPalette() {
  const palettes=[
    {sky:'#04080f',water:'#071624',deep:'#040c1a',foam:'rgba(100,150,200,0.15)'},
    {sky:'#030712',water:'#060f1e',deep:'#030810',foam:'rgba(80,100,180,0.12)'},
    {sky:'#020509',water:'#040d18',deep:'#020609',foam:'rgba(60,80,160,0.1)'},
    {sky:'#010305',water:'#030810',deep:'#010205',foam:'rgba(40,60,140,0.08)'},
    {sky:'#000103',water:'#020508',deep:'#000102',foam:'rgba(20,40,120,0.06)'},
  ];
  return palettes[Math.min(G.player.layer-1,4)];
}
 
function drawOcean(pal) {
  const t=G.waveTime;
  // Sky gradient
  const skyGrad=ctx.createLinearGradient(0,0,0,H*0.35);
  skyGrad.addColorStop(0,G.weather==='aurora'?'#0d1a2a':pal.sky);
  skyGrad.addColorStop(1,pal.water);
  ctx.fillStyle=skyGrad; ctx.fillRect(0,0,W,H*0.35);
 
  // Aurora
  if(G.weather==='aurora') {
    for(let i=0;i<5;i++){
      const g=ctx.createLinearGradient(0,0,W,0);
      g.addColorStop(0,'transparent');
      g.addColorStop(0.3+i*0.1,`hsla(${160+i*25},80%,40%,${0.06+Math.sin(t*0.01+i)*0.03})`);
      g.addColorStop(1,'transparent');
      ctx.fillStyle=g; ctx.fillRect(0,H*(0.05+i*0.04),W,H*0.06);
    }
  }
 
  // Ocean body
  const oceGrad=ctx.createLinearGradient(0,H*0.3,0,H);
  oceGrad.addColorStop(0,pal.water);
  oceGrad.addColorStop(0.4,pal.deep);
  oceGrad.addColorStop(1,'#000');
  ctx.fillStyle=oceGrad; ctx.fillRect(0,H*0.3,W,H*0.7);
 
  // Animated waves
  for(let wave=0;wave<3;wave++){
    ctx.beginPath();
    ctx.moveTo(0,H*(0.3+wave*0.04));
    for(let x=0;x<=W;x+=8){
      const y=H*(0.3+wave*0.04)+Math.sin(x*0.015+t*0.8+wave*1.5)*3+Math.sin(x*0.008+t*0.5+wave)*4;
      ctx.lineTo(x,y);
    }
    ctx.lineTo(W,H); ctx.lineTo(0,H);
    ctx.fillStyle=pal.foam;
    ctx.fill();
  }
 
  // Depth fog
  if(G.player.layer>=3){
    const fog=ctx.createLinearGradient(0,H*0.5,0,H);
    fog.addColorStop(0,'transparent');
    fog.addColorStop(1,`rgba(0,0,0,${0.3+G.player.layer*0.1})`);
    ctx.fillStyle=fog; ctx.fillRect(0,H*0.5,W,H*0.5);
  }
 
  // Storm effect
  if(G.weather==='storm'&&Math.random()<0.03){
    ctx.strokeStyle='rgba(200,200,255,0.5)';
    ctx.lineWidth=1;
    ctx.beginPath();
    const lx=Math.random()*W;
    ctx.moveTo(lx,0); ctx.lineTo(lx+20,H*0.4);
    ctx.stroke();
  }
 
  // Fog overlay
  if(G.weather==='fog'){
    const fogRad=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,W*0.8);
    fogRad.addColorStop(0,'transparent');
    fogRad.addColorStop(1,'rgba(40,60,80,0.35)');
    ctx.fillStyle=fogRad; ctx.fillRect(0,0,W,H);
  }
}
 
function drawBoids(pal) {
  for(const b of G.boids){
    ctx.save();
    ctx.translate(b.x,b.y);
    ctx.rotate(b.angle);
    // Fish body wobble
    const w=Math.sin(b.wobble)*0.2;
    ctx.scale(1+w,1-w*0.5);
    // Glow for eldritch layer
    if(G.player.layer>=3&&Math.random()<0.01){
      ctx.shadowColor='#e040fb';
      ctx.shadowBlur=12;
    }
    ctx.fillStyle=`rgba(100,160,200,0.4)`;
    ctx.beginPath();
    ctx.ellipse(0,0,b.size,b.size*0.4,0,0,Math.PI*2);
    ctx.fill();
    // Tail
    ctx.beginPath();
    ctx.moveTo(-b.size,0);
    ctx.lineTo(-b.size*1.4,-b.size*0.4+Math.sin(b.wobble)*2);
    ctx.lineTo(-b.size*1.4,b.size*0.4+Math.sin(b.wobble+1)*2);
    ctx.fillStyle=`rgba(80,140,180,0.3)`;
    ctx.fill();
    ctx.restore();
  }
}
 
function drawPlayer() {
  const t=G.waveTime;
  const px=W/2, py=H*0.3-8;
  const bob=Math.sin(t*1.2)*3;
  // Boat hull
  ctx.save();
  ctx.translate(px,py+bob);
  // Glow for eldritch
  if(G.glitch){ctx.shadowColor='#e040fb';ctx.shadowBlur=20;}
  // Hull
  ctx.fillStyle='#2c1a0e';
  ctx.beginPath();
  ctx.ellipse(0,8,36,10,0,0,Math.PI*2);
  ctx.fill();
  ctx.fillStyle='#3d2612';
  ctx.beginPath();
  ctx.ellipse(0,5,32,8,0,0,Math.PI*2);
  ctx.fill();
  // Mast
  ctx.strokeStyle='#4a3020';ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(0,5);ctx.lineTo(0,-28);ctx.stroke();
  // Sail
  ctx.fillStyle='rgba(180,160,140,0.8)';
  ctx.beginPath();ctx.moveTo(0,-26);ctx.lineTo(16,-10);ctx.lineTo(0,-2);ctx.fill();
  // Fishing rod
  ctx.strokeStyle='#6b4c2a';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(-18,-2);ctx.lineTo(-28,-20);ctx.stroke();
  ctx.restore();
 
  // Line to bobber
  if(G.bobber){
    ctx.strokeStyle='rgba(200,200,200,0.5)'; ctx.lineWidth=1;
    ctx.beginPath();
    ctx.moveTo(px-26,py-20+Math.sin(t*1.2)*3);
    ctx.quadraticCurveTo(px+(-26+G.bobber.x-px)*0.5, py-20+(G.bobber.y-(py-20))*0.5-30, G.bobber.x,G.bobber.y);
    ctx.stroke();
    // Bobber
    G.bobber.wobble+=0.15;
    const bby=G.bobber.y+Math.sin(G.bobber.wobble)*4;
    ctx.fillStyle='#e74c3c';
    ctx.beginPath();ctx.arc(G.bobber.x,bby,7,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='rgba(255,255,255,0.3)';
    ctx.beginPath();ctx.arc(G.bobber.x-2,bby-2,2,0,Math.PI*2);ctx.fill();
    // Bite warning
    if(G.state==='waiting'&&G.biteTimer<30){
      ctx.fillStyle='#e74c3c';
      ctx.font='bold 14px serif';
      ctx.textAlign='center';
      ctx.fillText('❗',G.bobber.x,bby-16);
    }
  }
}
 
function drawParticles() {
  for(const p of G.particles){
    ctx.globalAlpha=p.life;
    if(p.type==='gore'){
      ctx.fillStyle=p.color;
      ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();
    } else {
      ctx.fillStyle=p.color;
      ctx.fillRect(p.x,p.y,p.size,p.size);
    }
  }
  ctx.globalAlpha=1;
}
 
function drawFloats() {
  ctx.textAlign='center';
  for(const f of G.floats){
    ctx.globalAlpha=f.life;
    ctx.fillStyle=f.color;
    ctx.font=`bold ${f.size}px 'IM Fell English',serif`;
    ctx.fillText(f.text,f.x,f.y);
  }
  ctx.globalAlpha=1;
}
 
function drawSanityVfx() {
  const s=G.player.sanity;
  if(s<80){
    const intensity=(80-s)/80;
    // Vignette
    const v=ctx.createRadialGradient(W/2,H/2,H*0.3,W/2,H/2,H*0.8);
    v.addColorStop(0,'transparent');
    v.addColorStop(1,`rgba(120,0,40,${intensity*0.6})`);
    ctx.fillStyle=v; ctx.fillRect(0,0,W,H);
  }
  if(s<40&&Math.random()<0.05){
    // Hallucination flash
    ctx.fillStyle=`rgba(107,33,168,${Math.random()*0.08})`;
    ctx.fillRect(0,0,W,H);
  }
  if(G.glitch&&!document.querySelector('.settings')?.reduceMotion){
    const gi=Math.random()*4-2;
    ctx.fillStyle='rgba(0,0,0,0.01)';
    for(let i=0;i<3;i++){
      const gy=Math.random()*H,gh=Math.random()*20;
      const id=ctx.getImageData(0,gy,W,gh);
      ctx.putImageData(id,gi,gy);
    }
  }
}
 
// ─── GAME LOOP ───────────────────────────────────────────
function update() {
  G.frameCount++;
  G.waveTime+=0.02;
  G.time+=0.0003;
  if(G.time>1)G.time=0;
 
  tickWeather();
  updateBoids();
 
  // Cast power charge
  if(castCharging && G.state==='casting'){
    castPow+=castPowDir*1.5;
    if(castPow>=100){castPow=100;castPowDir=-1;}
    if(castPow<=0){castPow=0;castPowDir=1;}
    document.getElementById('cast-meter-fill').style.height=castPow+'%';
  }
 
  // Waiting for bite
  if(G.state==='waiting'){
    G.biteTimer--;
    if(G.biteTimer<=0){
      G.state='reeling';
      G.fishOnLine=selectFish();
      startReel(G.fishOnLine);
    }
  }
 
  if(G.state==='reeling') tickReel();
 
  // Passive sanity drain
  if(G.frameCount%300===0) drainSanity(0.5);
 
  // Particles
  G.particles=G.particles.filter(p=>{
    p.x+=p.vx; p.y+=p.vy;
    p.vx*=0.95; p.vy+=0.08;
    p.life-=0.018;
    return p.life>0;
  });
  G.floats=G.floats.filter(f=>{
    f.y+=f.vy; f.life-=0.012; return f.life>0;
  });
 
  if(G.screenShake>0){G.screenShake*=0.88;}
 
  updateHUD();
}
 
function draw() {
  ctx.clearRect(0,0,W,H);
  const pal=getLayerPalette();
  const sx=G.screenShake?(Math.random()-0.5)*G.screenShake:0;
  const sy=G.screenShake?(Math.random()-0.5)*G.screenShake:0;
  ctx.save();
  ctx.translate(sx,sy);
  drawOcean(pal);
  drawBoids(pal);
  drawPlayer();
  drawParticles();
  drawFloats();
  drawSanityVfx();
  ctx.restore();
}
 
function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}
 
// ─── UI ACTIONS ──────────────────────────────────────────
function closeModal(id){document.getElementById(id).classList.remove('open');}
window.closeModal=closeModal;
 
function openModal(id){
  document.querySelectorAll('.modal-overlay').forEach(m=>m.classList.remove('open'));
  document.getElementById(id).classList.add('open');
}
 
function sellAll() {
  let total=0;
  for(const item of G.player.inventory) {
    const f=FISH.find(f=>f.id===item.fish);
    if(f) total+=item.value;
  }
  G.player.inventory=[]; G.player.coins+=total;
  floatText(W/2,H/3,`+${total}💰`,'#f4d57e',16);
  updateHUD(); renderInv(); maybeAutoSave();
}
window.sellAll=sellAll;
 
function sellRares() {
  const rare=['rare','epic','eldritch','mythical','legendary'];
  let total=0,keep=[];
  for(const item of G.player.inventory){
    const f=FISH.find(f=>f.id===item.fish);
    if(f&&rare.includes(f.rarity)){total+=item.value;}
    else keep.push(item);
  }
  G.player.inventory=keep; G.player.coins+=total;
  floatText(W/2,H/3,`+${total}💰`,'#f4d57e',16);
  updateHUD(); renderInv(); maybeAutoSave();
}
window.sellRares=sellRares;
 
function renderQuests() {
  const seer=['The lines between worlds thin with each catch...',
    '"It watches you fish. It has watched since before fish existed."',
    '"Do not read the writing on the scales. Do not."',
    '"The Mythical waits at the end of the chain, not the end of luck."',
    '"Cast deep. The surface lies."'];
  document.getElementById('quest-npc-msg').textContent=seer[Math.floor(Math.random()*seer.length)];
 
  let activeHtml='',availHtml='',doneHtml='';
  G.quests.forEach(qs=>{
    const def=QUEST_DEFS.find(d=>d.id===qs.id);
    if(!def) return;
    const step=qs.active&&!qs.done?def.steps[qs.stepIndex]:null;
    const progress=qs.progress[qs.stepIndex]||0;
 
    const card=`<div class="quest-item ${qs.done?'complete':qs.active?'active':''}">
      <div class="quest-title">${qs.done?'✅':qs.active?'⏳':'📋'} ${def.name}</div>
      <div class="quest-desc">${def.desc}</div>
      ${step?`<div style="font-size:10px;color:var(--silver);margin-top:4px;">${qs.stepIndex+1}/${def.steps.length}: ${step.desc}</div>
      <div class="progress-bar"><div class="progress-fill" style="width:${Math.min(100,progress/step.amount*100)}%"></div></div>
      <div style="font-size:9px;color:var(--textdim);">${progress}/${step.amount}</div>`:''}
      ${!qs.active&&!qs.done&&(!def.layer||G.player.layer>=def.layer)?
        `<button class="btn" onclick="acceptQuest('${def.id}')" style="margin-top:6px;font-size:9px;">Accept Quest</button>`
        :(def.layer&&G.player.layer<def.layer?`<span style="font-size:9px;color:#e74c3c;">Requires Layer ${def.layer}</span>`:'')
      }
    </div>`;
 
    if(qs.done) doneHtml+=card;
    else if(qs.active) activeHtml+=card;
    else availHtml+=card;
  });
  document.getElementById('quest-active-list').innerHTML=activeHtml||'<p style="font-size:10px;color:var(--textdim);">No active quests.</p>';
  document.getElementById('quest-available-list').innerHTML=availHtml||'<p style="font-size:10px;color:var(--textdim);">None available at your layer.</p>';
  document.getElementById('quest-done-list').innerHTML=doneHtml||'';
}
 
function acceptQuest(id) {
  const qs=G.quests.find(q=>q.id===id);
  const def=QUEST_DEFS.find(d=>d.id===id);
  if(!qs||!def) return;
  if(qs.active||qs.done) return;
  if(def.layer&&G.player.layer<def.layer) return;
  qs.active=true; qs.stepIndex=0; qs.progress=def.steps.map(()=>0);
  floatText(W/2,H/3,'📜 Quest Accepted!','#7fc9ff',14);
  renderQuests();
}
window.acceptQuest=acceptQuest;
 
function renderEnc() {
  const term=(document.getElementById('enc-search')?.value||'').toLowerCase();
  document.getElementById('enc-count').textContent=`${G.player.discoveredFish.size}/${FISH.length}`;
  const rarityClass={common:'rarity-common',uncommon:'rarity-uncommon',rare:'rarity-rare',epic:'rarity-epic',eldritch:'rarity-eldritch',mythical:'rarity-mythical',legendary:'rarity-legendary'};
  const html=FISH.filter(f=>!term||f.name.toLowerCase().includes(term)||f.rarity.includes(term)).map(f=>{
    const known=G.player.discoveredFish.has(f.id);
    return `<div class="fish-card ${known?'':'undiscovered'}">
      <span style="font-size:18px;">${known?f.emoji:'❓'}</span>
      <div style="flex:1;">
        <div style="font-size:11px;font-weight:bold;">${known?f.name:'???'} <span class="${rarityClass[f.rarity]||''}">[${f.rarity}]</span></div>
        <div style="font-size:9px;color:var(--textdim);">${known?f.desc:''}</div>
        ${known?`<div style="font-size:9px;color:var(--gold);">L${f.layer} · ${f.weight[0]}–${f.weight[1]}lbs · 💰${f.value}</div>`:''}
      </div>
    </div>`;
  }).join('');
  document.getElementById('enc-list').innerHTML=html;
}
 
function renderShop() {
  const seer=["\"The altar hungers.\"","\"These baits cost me dearly. Worth it.\"","\"Trade well.\"","\"The deep demands a tithe.\""];
  document.getElementById('shop-seer-msg').textContent=seer[Math.floor(Math.random()*seer.length)];
  document.getElementById('shop-bait-list').innerHTML=BAIT_SHOP.map(b=>`
    <div class="fish-card" style="margin:3px 0;">
      <span style="font-size:16px;">${b.emoji}</span>
      <div style="flex:1;">
        <div style="font-size:11px;">${b.name} <span style="color:var(--textdim);font-size:9px;">${b.desc}</span></div>
        <div style="font-size:9px;color:var(--textdim);">Have: ${getBaitAmount(b.id)} · 💰${b.cost}</div>
      </div>
      <button class="btn" onclick="buyBait('${b.id}')" style="font-size:9px;padding:4px 8px;">${G.player.coins>=b.cost?'Buy':'💀'}</button>
    </div>`).join('');
 
  document.getElementById('shop-artifact-list').innerHTML=G.player.artifacts.length?
    G.player.artifacts.map(a=>`<div class="fish-card"><span>🔮</span><div>${a}</div></div>`).join(''):
    '<p style="font-size:10px;color:var(--textdim);">No artifacts yet. Complete quest chains.</p>';
}
 
function buyBait(id) {
  const b=BAIT_SHOP.find(b=>b.id===id);
  if(!b||G.player.coins<b.cost) return;
  G.player.coins-=b.cost;
  addBait(id,1);
  floatText(W/2,H/3,`+${b.emoji} ${b.name}`,'#c9953a',13);
  updateQuestProgress('buy_bait',id,1);
  updateHUD(); renderShop(); maybeAutoSave();
}
window.buyBait=buyBait;
 
function renderInv() {
  document.getElementById('inv-coins').textContent=G.player.coins;
  const baitStr=G.player.bait.map(b=>{
    const def=BAIT_SHOP.find(bd=>bd.id===b.id);
    return `${def?.emoji||'🪱'}${b.amount}`;
  }).join(' ');
  document.getElementById('inv-bait').textContent=baitStr||'None';
  const rarityClass={common:'rarity-common',uncommon:'rarity-uncommon',rare:'rarity-rare',epic:'rarity-epic',eldritch:'rarity-eldritch',mythical:'rarity-mythical',legendary:'rarity-legendary'};
  if(!G.player.inventory.length){document.getElementById('inv-fish-list').innerHTML='<p style="font-size:10px;color:var(--textdim);">Empty. Go fish.</p>';return;}
  document.getElementById('inv-fish-list').innerHTML=G.player.inventory.slice(-50).reverse().map(item=>{
    const f=FISH.find(f=>f.id===item.fish);
    if(!f) return '';
    return `<div class="fish-card">
      <span>${f.emoji}</span>
      <div style="flex:1;"><span style="font-size:11px;">${f.name}</span> <span class="${rarityClass[f.rarity]||''}" style="font-size:9px;">[${f.rarity}]</span>
      <div style="font-size:9px;color:var(--textdim);">${item.weight}lbs · 💰${item.value}</div></div>
    </div>`;
  }).join('');
}
 
function renderUpgrades() {
  document.getElementById('upgrade-list').innerHTML=ROD_UPGRADES.map(u=>{
    const lv=getUpgradeLevel(u.id);
    const cost=upgradeCost(u.id);
    const maxed=lv>=u.maxLevel;
    return `<div class="fish-card" style="margin:4px 0;flex-direction:column;align-items:flex-start;gap:4px;">
      <div style="display:flex;justify-content:space-between;width:100%;align-items:center;">
        <div style="font-size:11px;font-weight:bold;color:var(--goldhi);">${u.name} (${lv}/${u.maxLevel})</div>
        <button class="btn" ${maxed||G.player.coins<cost?'disabled style="opacity:0.4;"':''} onclick="buyUpgrade('${u.id}')" style="font-size:9px;padding:4px 8px;">${maxed?'MAX':'💰 '+cost}</button>
      </div>
      <div style="font-size:10px;color:var(--textdim);">${u.desc}</div>
      <div class="progress-bar" style="width:100%;"><div class="progress-fill" style="width:${lv/u.maxLevel*100}%;"></div></div>
    </div>`;
  }).join('');
}
 
function buyUpgrade(id) {
  const def=ROD_UPGRADES.find(r=>r.id===id);
  if(!def) return;
  const lv=getUpgradeLevel(id);
  if(lv>=def.maxLevel) return;
  const cost=upgradeCost(id);
  if(G.player.coins<cost) { floatText(W/2,H/3,'Need more coins!','#e74c3c',13); return; }
  G.player.coins-=cost;
  G.player.upgrades[id]=(G.player.upgrades[id]||0)+1;
  floatText(W/2,H/3,`⬆️ ${def.name} Lv${G.player.upgrades[id]}`,'#f4d57e',14);
  updateHUD(); renderUpgrades(); maybeAutoSave();
}
window.buyUpgrade=buyUpgrade;
 
// ─── BAIT SELECTION ──────────────────────────────────────
function cycleBait() {
  const available=G.player.bait.filter(b=>b.amount>0);
  if(!available.length) return;
  const idx=available.findIndex(b=>b.id===G.player.activeBait);
  G.player.activeBait=available[(idx+1)%available.length].id;
  const def=BAIT_SHOP.find(b=>b.id===G.player.activeBait);
  floatText(W/2,H*0.6,`Bait: ${def?.emoji||'🪱'} ${def?.name||G.player.activeBait}`,'#c9953a',12);
  // Consume 1 bait
  const b=G.player.bait.find(b=>b.id===G.player.activeBait);
  if(b&&b.amount>0) b.amount--;
}
 
// ─── INPUT ───────────────────────────────────────────────
let touchStartX=0,touchStartY=0,touchStartTime=0;
let castTapStart=null;
 
canvas.addEventListener('touchstart',e=>{
  e.preventDefault();
  const t=e.changedTouches[0];
  touchStartX=t.clientX; touchStartY=t.clientY; touchStartTime=Date.now();
  if(G.state==='idle'){
    castTapStart={x:t.clientX,y:t.clientY,time:Date.now()};
    startCast();
  } else if(G.state==='reeling') {
    reelHook();
  }
},{passive:false});
 
canvas.addEventListener('touchend',e=>{
  e.preventDefault();
  if(G.state==='casting'){
    const t=e.changedTouches[0];
    // Cast toward touch point — aim for that x, ocean level
    const tx=t.clientX;
    const ty=H*0.35+Math.random()*H*0.2;
    releaseCast(tx,ty);
  }
},{passive:false});
 
document.addEventListener('keydown',e=>{
  if(e.code==='Space'||e.code==='Enter'){
    e.preventDefault();
    if(G.state==='idle') startCast();
    else if(G.state==='casting') releaseCast(W/2+Math.random()*100-50, H*0.4+Math.random()*H*0.15);
    else if(G.state==='reeling') reelHook();
  }
  if(e.code==='KeyB') cycleBait();
  if(e.code==='KeyS' && e.ctrlKey){ e.preventDefault(); saveGame(); floatText(W/2,H/3,'💾 Saved!','#c9953a',14); }
  if(e.code==='Escape') document.querySelectorAll('.modal-overlay').forEach(m=>m.classList.remove('open'));
  if(e.code==='KeyQ'){ renderQuests(); openModal('modal-quests'); }
  if(e.code==='KeyE'){ renderEnc(); openModal('modal-enc'); }
  if(e.code==='KeyI'){ renderInv(); openModal('modal-inv'); }
});
 
// Cast meter zone positioning
(function setCastZone(){
  const el=document.getElementById('cast-meter-zone');
  el.style.bottom='30%'; el.style.height='25%';
})();
 
// Button wiring
document.getElementById('btn-quests').addEventListener('click',()=>{ renderQuests(); openModal('modal-quests'); });
document.getElementById('btn-enc').addEventListener('click',()=>{ renderEnc(); openModal('modal-enc'); G.player.loreRead++; updateQuestProgress('lore_read',null,1); });
document.getElementById('btn-shop').addEventListener('click',()=>{ renderShop(); openModal('modal-shop'); });
document.getElementById('btn-inv').addEventListener('click',()=>{ renderInv(); openModal('modal-inv'); });
document.getElementById('btn-upgrade').addEventListener('click',()=>{ renderUpgrades(); openModal('modal-upgrade'); });
document.getElementById('btn-dive').addEventListener('click',()=>{
  // Dive deeper
  if(G.player.layer<5){
    showEventBanner(`🌊 Descended to Layer ${G.player.layer+1}... if you dare.`);
  } else {
    showEventBanner("You are already in the deepest abyss. There is nowhere left to fall.");
  }
});
 
document.getElementById('enc-search').addEventListener('input', renderEnc);
 
// Close modals on overlay click
document.querySelectorAll('.modal-overlay').forEach(m=>{
  m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('open'); });
});
 
// ─── AUTO SAVE ───────────────────────────────────────────
function maybeAutoSave() {
  if(G.frameCount-G.lastAutoSave > 1800) {
    saveGame(); G.lastAutoSave=G.frameCount;
  }
}
 
// ─── INIT ─────────────────────────────────────────────────
initBoids(32);
loadGame();
updateHUD();
 
// Accept tutorial quest by default
(()=>{
  const tut=G.quests.find(q=>q.id==='tutorial_chain');
  if(tut&&!tut.active&&!tut.done){ tut.active=true; tut.stepIndex=0; tut.progress=[0,0,0]; }
  const daily=G.quests.find(q=>q.id==='daily_void');
  if(daily&&!daily.active){ daily.active=true; daily.stepIndex=0; daily.progress=[0]; }
  const daily2=G.quests.find(q=>q.id==='daily_commons');
  if(daily2&&!daily2.active){ daily2.active=true; daily2.stepIndex=0; daily2.progress=[0]; }
})();
 
// Opening banner
setTimeout(()=>{
  showEventBanner('🎣 Cast your line · SPACE/TAP to cast · Tap/SPACE to reel');
},500);
 
// Start!
loop();
</script>
