<script>
// ═══════════════════════════════════════════════════════════
//  ELDRITCH DEPTHS: TALE FISHER — Full Engine
// ═══════════════════════════════════════════════════════════
 
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
let W = canvas.width = window.innerWidth;
let H = canvas.height = window.innerHeight;
 
window.addEventListener('resize', () => {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
});
 
// ─── SAVE ────────────────────────────────────────────────
const SAVE_KEY = 'eldritch_depths_v3';
function saveGame() {
  localStorage.setItem(SAVE_KEY, JSON.stringify({
    player: { ...G.player, discoveredFish: [...G.player.discoveredFish] },
    quests: G.quests,
    time: G.time,
    weather: G.weather
  }));
}
function loadGame() {
  const raw = localStorage.getItem(SAVE_KEY);
  if (!raw) return;
  try {
    const s = JSON.parse(raw);
    Object.assign(G.player, s.player);
    G.player.discoveredFish = new Set(s.player.discoveredFish || []);
    G.quests = s.quests || G.quests;
    G.time = s.time || 0;
    G.weather = s.weather || 'calm';
  } catch(e) { console.warn('Save load failed', e); }
}
 
