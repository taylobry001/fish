// ─── QUEST ENGINE ─────────────────────────────────────────
function getQuestState(id) { return G.quests.find(q=>q.id===id); }
 
function updateQuestProgress(type, param, amount) {
  G.quests.forEach(qs => {
    if(!qs.active || qs.done) return;
    const def = QUEST_DEFS.find(d=>d.id===qs.id);
    if(!def) return;
    const step = def.steps[qs.stepIndex];
    if(!step) return;
 
    let matched = false;
    if(type==='catch' && step.type==='catch' && step.fishId===param) matched=true;
    if(type==='catch_rarity' && step.type==='catch_rarity' && step.rarity===param) matched=true;
    if(type==='catch_eldritch' && step.type==='catch_eldritch') matched=true;
    if(type==='catch_mythical' && step.type==='catch_mythical' && step.fishId===param) matched=true;
    if(type==='boss_reel' && step.type==='boss_reel') matched=true;
    if(type==='total_catches' && step.type==='total_catches') matched=true;
    if(type==='sanity_lost' && step.type==='sanity_lost') matched=true;
    if(type==='reach_layer' && step.type==='reach_layer' && G.player.layer>=step.amount) { qs.progress[qs.stepIndex]=step.amount; matched=false; }
    if(type==='zero_sanity' && step.type==='zero_sanity') matched=true;
    if(type==='lore_read' && step.type==='lore_read') matched=true;
    if(type==='buy_bait' && step.type==='buy_bait' && step.baitId===param) { qs.progress[qs.stepIndex]=1; matched=false; }
    if(type==='quest_done' && step.type==='quest_done' && step.questId===param) { qs.progress[qs.stepIndex]=1; matched=false; }
    if(type==='all_quests_done' && step.type==='all_quests_done') {
      const major=['deep_one_chain','cthulhu_prep','shoggoth_hunt','yithian_quest','deep_dive_quest','colour_quest','poseidon_quest'];
      const done = major.filter(id=>getQuestState(id)?.done).length;
      qs.progress[qs.stepIndex]=done;
      matched=false;
    }
    if(type==='catch_all_epic' && step.type==='catch_all_epic') {
      const epics=FISH.filter(f=>f.rarity==='epic');
      const caught=epics.filter(f=>G.player.discoveredFish.has(f.id)).length;
      if(caught>=epics.length) {qs.progress[qs.stepIndex]=1; matched=false;}
    }
 
    if(matched) {
      qs.progress[qs.stepIndex] = Math.min(step.amount, (qs.progress[qs.stepIndex]||0) + amount);
    }
 
    // Advance step?
    if((qs.progress[qs.stepIndex]||0) >= step.amount) {
      if(qs.stepIndex < def.steps.length-1) {
        qs.stepIndex++;
        floatText(W/2, H/3-20, `📜 Quest step complete!`, '#7fc9ff', 13);
        showEventBanner(`📜 "${def.name}" — Step ${qs.stepIndex}/${def.steps.length}`);
        // Queue mythical if last step
        if(qs.stepIndex === def.steps.length-1) {
          const lastStep=def.steps[qs.stepIndex];
          if(lastStep.type==='catch_mythical') {
            G.questMythicalReady = lastStep.fishId;
            floatText(W/2,H/3-40,'✨ Mythical fish nearby!','#f4d57e',14);
            showEventBanner(`✨ ${FISH.find(f=>f.id===lastStep.fishId)?.name} has been summoned!`);
          }
        }
      } else {
        // Quest complete!
        qs.done = true;
        qs.active = def.repeatable || false; // dailies stay active
        const reward = def.rewards[0];
        G.player.coins += reward.coins||0;
        G.player.xp += reward.xp||0;
        if(reward.bait) addBait(reward.bait.id, reward.bait.amount);
        if(reward.artifact) G.player.artifacts.push(reward.artifact);
        updateQuestProgress('quest_done', def.id, 1);
        floatText(W/2,H/3,'✅ QUEST COMPLETE!','#f4d57e',18);
        showEventBanner(`✅ Quest Complete: ${def.name} — +${reward.coins}💰`);
        G.screenShake=15;
      }
    }
  });
}
 
function addBait(id, amount) {
  const b = G.player.bait.find(b=>b.id===id);
  if(b) b.amount+=amount;
  else G.player.bait.push({id,amount});
}
 
