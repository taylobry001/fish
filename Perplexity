<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover" />
  <title>🌊 Mythic Waters · Realistic Fishing RPG</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --bg:#0a0a1a;
      --panel:#0d1a2e;
      --panel2:#162a3b;
      --accent:#5b9bb5;
      --gold:#ffd966;
      --text:#e6f7ff;
      --danger:#ff4444;
      --success:#4caf92;
    }
    body {
      background: var(--bg);
      display:flex;
      justify-content:center;
      align-items:center;
      min-height:100vh;
      font-family:'Segoe UI',system-ui,sans-serif;
      padding:8px;
      background-image:radial-gradient(ellipse at center, #1a1a3a 0%, #0a0a1a 100%);
      cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24'><circle cx='12' cy='12' r='8' fill='white' stroke='black' stroke-width='2'/><line x1='12' y1='2' x2='12' y2='8' stroke='black' stroke-width='2'/><line x1='12' y1='16' x2='12' y2='22' stroke='black' stroke-width='2'/><line x1='2' y1='12' x2='8' y2='12' stroke='black' stroke-width='2'/><line x1='16' y1='12' x2='22' y2='12' stroke='black' stroke-width='2'/></svg>") 12 12, crosshair;
      color: var(--text);
    }
    .game-container { display:flex; flex-direction:column; align-items:center; gap:6px; max-width:950px; width:100%; }
    .game-wrapper {
      background:linear-gradient(145deg, #1e2e4f 0%, #0c1a2c 100%);
      border-radius:28px;
      padding:10px;
      box-shadow:0 20px 40px rgba(0,0,0,0.8), inset 0 0 20px rgba(100,150,255,0.2);
      position:relative;
      width:100%;
    }
    canvas {
      display:block;
      margin:0 auto;
      border-radius:20px;
      box-shadow:0 0 30px rgba(61,110,140,0.5);
      background:#1a2e3c;
      width:100%;
      height:auto;
      max-width:900px;
      aspect-ratio:16/10;
    }
    .hud-top, .ui-bar {
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      backdrop-filter:blur(10px);
    }
    .hud-top {
      padding:8px 16px;
      background:rgba(0,0,0,0.8);
      border-radius:20px;
      color:white;
      font-size:0.75rem;
      margin-bottom:6px;
      border:1px solid rgba(100,150,255,0.3);
    }
    .ui-bar {
      padding:8px 14px;
      background:rgba(10,20,35,0.9);
      border-radius:25px;
      margin-top:8px;
      color:#e6f7ff;
      font-size:0.7rem;
      border:1px solid rgba(80,160,255,0.4);
    }
    button {
      background:linear-gradient(180deg, #3d6e8c 0%, #1b4057 100%);
      border:none;
      color:white;
      padding:7px 14px;
      border-radius:20px;
      font-weight:bold;
      cursor:pointer;
      box-shadow:0 3px 0 #0f1e2e, 0 5px 10px rgba(0,0,0,0.5);
      font-size:0.65rem;
      border-bottom:2px solid #7fc9ff;
      white-space:nowrap;
      transition:all 0.1s;
    }
    button:hover { transform:translateY(-2px); }
    button:active { transform:translateY(2px); }
    .modal {
      position:fixed;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      background:linear-gradient(160deg, var(--panel), var(--panel2));
      border:3px solid var(--accent);
      border-radius:20px;
      padding:18px;
      color:white;
      z-index:200;
      min-width:340px;
      max-width:650px;
      max-height:85vh;
      overflow-y:auto;
      display:none;
      box-shadow:0 20px 40px black;
    }
    .modal.active { display:block; animation:fadeIn 0.3s; }
    @keyframes fadeIn { from{opacity:0; transform:translate(-50%,-48%);} to{opacity:1; transform:translate(-50%,-50%);} }

    .qte-bar-container {
      position:fixed;
      bottom:80px;
      left:50%;
      transform:translateX(-50%);
      display:none;
      width:500px;
      height:50px;
      background:rgba(0,0,0,0.9);
      border-radius:25px;
      z-index:150;
      border:3px solid var(--danger);
      overflow:hidden;
    }
    .qte-bar-container.active { display:block; }
    .qte-bar-bg { position:absolute; inset:0; background:rgba(255,0,0,0.1); }
    .qte-bar-fill { height:100%; background:#ff3333; transition:width 0.05s; position:relative; z-index:1; }
    .qte-marker { position:absolute; top:-5px; width:8px; height:60px; background:white; box-shadow:0 0 20px white, 0 0 40px #ff4444; border-radius:4px; z-index:2; transition:left 0.05s; }
    .qte-target-zone { position:absolute; top:0; height:100%; background:rgba(255,68,68,0.5); border-left:3px solid #ff6666; border-right:3px solid #ff6666; z-index:1; }

    .boss-healthbar {
      position:fixed;
      top:20px;
      left:50%;
      transform:translateX(-50%);
      width:400px;
      height:30px;
      background:#1a1a1a;
      border:3px solid var(--danger);
      border-radius:12px;
      display:none;
      z-index:250;
    }
    .boss-healthbar.active { display:block; }
    .boss-fill { height:100%; background:var(--danger); border-radius:8px; transition:width 0.3s; }

    .catch-card {
      position:fixed;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%) scale(0);
      background:linear-gradient(160deg, var(--panel), var(--panel2));
      border:3px solid gold;
      border-radius:20px;
      padding:22px;
      color:white;
      z-index:300;
      text-align:center;
      min-width:300px;
      box-shadow:0 0 40px rgba(255,215,0,0.5);
      transition:transform 0.3s cubic-bezier(0.68,-0.55,0.27,1.55);
    }
    .catch-card.show { transform:translate(-50%,-50%) scale(1); }

    .drop-rate-table { width:100%; font-size:0.6rem; border-collapse:collapse; margin:8px 0; }
    .drop-rate-table td, .drop-rate-table th { padding:4px 8px; border:1px solid #3d6e8c; text-align:left; }
    .drop-rate-table th { background:#1a3a4a; color:#ffd966; }

    .small { font-size:0.7rem; color:#b6d9f0; }
    .hidden { display:none !important; }
  </style>
</head>
<body>
<div class="game-container">
  <div class="hud-top">
    <span id="weatherHud">☀️ Clear</span>
    <span id="timeHud">🕐 12:00</span>
    <span id="eventHud">🎣 Normal</span>
    <span id="pearlHud">💎 <span id="pearlCount">0</span>/6 Shards</span>
    <span id="eldritchHud">👁️ 0/5 Eldritch</span>
    <span id="saveHud">💾 Saved</span>
  </div>

  <div class="game-wrapper">
    <canvas id="gameCanvas" width="900" height="560"></canvas>
    <div class="ui-bar">
      <span>🎣 <span id="playerName">Angler</span></span>
      <span>🐟 <span id="fishCount">0</span></span>
      <span>💰 <span id="goldDisplay">150</span></span>
      <span>🚤 <span id="boatStatus">No Boat</span></span>
      <button id="inventoryBtn">🎒 Inv (I)</button>
      <button id="ratesBtn">📊 Rates</button>
      <button id="questBtn">📜 Quests</button>
      <button id="fishBioBtn">📖 Bio (F)</button>
      <button id="shopBtn">🏪 Jimmy</button>
      <button id="settingsBtn">⚙️ Settings</button>
    </div>
  </div>

  <div class="small">🖱️ Click water to cast · SPACE = hook / enter ocean · I:Inventory · Q:Quests · F:Bio · S:Save</div>
</div>

<div id="ratesModal" class="modal">
  <span onclick="document.getElementById('ratesModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>📊 Complete Drop Rates</h3>
  <h4 style="color:#ffd966;margin-top:10px;">🐟 Fish Spawn Rates</h4>
  <table class="drop-rate-table">
    <tr><th>Rarity</th><th>Base Rate</th><th>With ⭐ Spot (1.5x)</th><th>With ⭐⭐ Spot (3x)</th></tr>
    <tr><td style="color:#a0b8c0;">Common</td><td>45.0%</td><td>67.5%</td><td>100%</td></tr>
    <tr><td style="color:#7c9c4a;">Uncommon</td><td>25.0%</td><td>37.5%</td><td>75.0%</td></tr>
    <tr><td style="color:#e86f8a;">Rare</td><td>15.0%</td><td>22.5%</td><td>45.0%</td></tr>
    <tr><td style="color:#c9a0ff;">Epic</td><td>8.0%</td><td>12.0%</td><td>24.0%</td></tr>
    <tr><td style="color:#ff8c00;">Legendary</td><td>3.5%</td><td>5.25%</td><td>10.5%</td></tr>
    <tr><td style="color:#ff44aa;">Mythical</td><td>1.8%</td><td>2.7%</td><td>5.4%</td></tr>
    <tr><td style="color:#40e0d0;">Tale Fish</td><td>0.5%</td><td>0.75%</td><td>1.5%</td></tr>
    <tr><td style="color:#2d5a27;">Eldritch</td><td>0.15%</td><td>0.23%</td><td>0.45%</td></tr>
    <tr><td style="color:#ff0000;">World Boss</td><td>0.05%</td><td>0.075%</td><td>0.15%</td></tr>
    <tr><td style="color:#4a90d9;">Mythical Tale</td><td>0.02%</td><td>Need Pearl</td><td>Need Pearl</td></tr>
  </table>

  <h4 style="color:#ffd966;margin-top:10px;">🧬 Mutation Rates (Per Catch)</h4>
  <table class="drop-rate-table">
    <tr><th>Mutation</th><th>Chance</th><th>Effect</th></tr>
    <tr><td style="color:#ff6600;">Alpha</td><td>8.0%</td><td>1.8x weight, 1.5x value</td></tr>
    <tr><td style="color:#1a1a1a;">Melanistic</td><td>5.0%</td><td>2.2x value</td></tr>
    <tr><td style="color:#ffffff;">Piebald</td><td>3.0%</td><td>2.8x value</td></tr>
    <tr><td style="color:#ffcccc;">Albino</td><td>0.5%</td><td>3.5x value (Ultra Rare)</td></tr>
    <tr><td style="color:#ff8c00;">Giant</td><td>4.0%</td><td>2.5x weight, 3x value</td></tr>
    <tr><td style="color:#ff00ff;">Fluorescent</td><td>6.0%</td><td>2.5x value</td></tr>
    <tr><td style="color:#00ff00;">Radioactive</td><td>7.0%</td><td>0.8x weight, 1.5x value</td></tr>
  </table>

  <h4 style="color:#ffd966;margin-top:10px;">💎 Pearl Shard Drop</h4>
  <table class="drop-rate-table">
    <tr><th>Location</th><th>Base Rate</th><th>With ⭐⭐ Spot</th></tr>
    <tr><td>Lake/River</td><td>0% (ocean only)</td><td>N/A</td></tr>
    <tr><td>Ocean (normal spot)</td><td>1.0%</td><td>3.0%</td></tr>
    <tr><td>Ocean (⭐ Star spot)</td><td>1.5%</td><td>4.5%</td></tr>
  </table>

  <h4 style="color:#ffd966;margin-top:10px;">⚡ Boss Fight Spawn</h4>
  <table class="drop-rate-table">
    <tr><th>Condition</th><th>Rate</th></tr>
    <tr><td>While in Ocean</td><td>0.1% per game tick (~6% per minute)</td></tr>
    <tr><td>Boss Duration</td><td>45 seconds</td></tr>
    <tr><td>Weather During Boss</td><td>Always Storm ⛈️</td></tr>
    <tr><td>Boss Fish Rate</td><td>5% during event (vs 0.05% normal)</td></tr>
  </table>

  <h4 style="color:#ffd966;margin-top:10px;">⭐ Fishing Spot Bonuses</h4>
  <table class="drop-rate-table">
    <tr><th>Spot</th><th>Drop Bonus</th></tr>
    <tr><td>Misty Lake</td><td>1.0x (Normal)</td></tr>
    <tr><td>Silver River</td><td>1.5x ⭐</td></tr>
    <tr><td>Deep Ocean</td><td>2.0x ⭐⭐</td></tr>
    <tr><td>Ocean Zones (Random)</td><td>1.0x - 3.0x</td></tr>
  </table>
</div>

<div id="inventoryModal" class="modal">
  <span onclick="document.getElementById('inventoryModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🎒 Inventory</h3>
  <p style="font-size:0.7rem;">
    Gold: <span id="invGold">150</span>💰 |
    Pearls: <span id="invPearls">0</span>/6 💎 |
    Perfect Pearl: <span id="invPearlStatus">❌</span>
  </p>
  <div style="display:flex; gap:6px; flex-wrap:wrap; margin:8px 0;">
    <button id="sortInvBtn">↕ Sort</button>
    <button id="sellDupesBtn">💰 Sell Dupes</button>
    <button id="sellRareBtn">⭐ Sell Rare+</button>
  </div>
  <div id="inventoryList" style="max-height:300px;overflow-y:auto;"></div>
</div>

<div id="questModal" class="modal">
  <span onclick="document.getElementById('questModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>📜 Quest Journal</h3>
  <div id="availableQuests"></div>
  <h4 style="color:#ffd966;margin-top:12px;">Active Quests:</h4>
  <div id="activeQuests"></div>
</div>

<div id="fishBioModal" class="modal">
  <span onclick="document.getElementById('fishBioModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🐠 FishBio · <span id="bioCount">0</span>/22</h3>
  <input id="bioSearch" placeholder="Search fish..." style="width:100%;margin:8px 0;padding:8px;border-radius:8px;border:none;background:#0b1320;color:white;">
  <div id="bioGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:10px 0;max-height:350px;overflow-y:auto;"></div>
  <div id="mutationGuide" style="margin-top:10px;border-top:1px solid #5b9bb5;padding-top:8px;">
    <h4 style="color:#ffd966;">🧬 Mutation Guide</h4>
    <div id="mutationList"></div>
  </div>
</div>

<div id="shopModal" class="modal">
  <span onclick="document.getElementById('shopModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>🏪 Fishin Jimmy's Shop</h3>
  <p id="jimmyDialogue" style="color:#ffd966;">"Welcome, partner!"</p>
  <div style="display:flex;gap:6px;margin:10px 0;flex-wrap:wrap;">
    <button id="sellAllBtn">💰 Sell All Fish</button>
    <button id="buyBoatBtn">🚤 Buy Boat (1000💰)</button>
    <button id="craftPearlBtn" style="display:none;">💎 Craft Perfect Pearl</button>
    <button id="saveBtn">💾 Save</button>
    <button id="loadBtn">📂 Load</button>
  </div>
</div>

<div id="settingsModal" class="modal">
  <span onclick="document.getElementById('settingsModal').classList.remove('active')" style="float:right;cursor:pointer;font-size:1.5rem;">✖</span>
  <h3>⚙️ Settings</h3>
  <label><input type="checkbox" id="reduceMotionToggle"> Reduced motion</label><br><br>
  <label><input type="checkbox" id="highContrastToggle"> High contrast</label><br><br>
  <label><input type="checkbox" id="autoSaveToggle" checked> Autosave</label><br><br>
  <label><input type="checkbox" id="showTipsToggle" checked> Show tips</label><br><br>
  <button id="exportSaveBtn">📤 Export Save</button>
  <button id="importSaveBtn">📥 Import Save</button>
</div>

<div class="qte-bar-container" id="qteBarContainer">
  <div class="qte-bar-bg"></div>
  <div class="qte-target-zone" id="qteTargetZone"></div>
  <div class="qte-marker" id="qteMarker"></div>
  <div class="qte-bar-fill" id="qteBarFill"></div>
</div>

<div class="boss-healthbar" id="bossBar">
  <div class="boss-fill" id="bossFill" style="width:100%"></div>
</div>

<div class="catch-card" id="catchCard">
  <div id="catchEmoji" style="font-size:3rem;">🐟</div>
  <h2 id="catchName">Fish</h2>
  <div id="catchRarity" style="color:#ffd966;">Common</div>
  <div id="catchChance" style="font-size:0.7rem;color:#aaccdd;"></div>
  <div id="catchWeight">0.0 lbs</div>
  <div id="catchMutation" style="color:#ffaa00;"></div>
  <div id="catchValue">💰 0</div>
</div>

<script>
